@model WebWayCMS.Controllers.GenericPageConfiguration

@{
    ViewData["Title"] = ViewContext.RouteData.Values["title"]?.ToString() ?? "Page";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (!string.IsNullOrWhiteSpace(Model.Meta))
{
    @section Meta {
        @Html.Raw(Model.Meta)
    }
}

@if (!string.IsNullOrWhiteSpace(Model.Style))
{
    @section Styles {
        <style>
            @Html.Raw(Model.Style)
        </style>
    }
}

<section class="section">
<div class="container is-fluid">
@await Component.InvokeAsync("ContentZone", new { zoneName = "Main" })
</div>
</section>
