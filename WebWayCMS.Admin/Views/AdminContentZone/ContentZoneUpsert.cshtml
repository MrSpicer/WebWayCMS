@model WebWayCMS.Models.ContentZone.ContentZoneUpsertViewModel

@{
    var isEdit = Model?.NodeId != null && Model.NodeId != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit Content Zone" : "New Content Zone";
    var header = new AdminPageHeaderModel((string)ViewData["Title"]!)
    {
        Fluid = false,
        NodeId = Model?.NodeId,
        Crumbs = [new AdminCrumb("Content Zones", Url.Action("Index", "AdminContent", new { contentType = "contentzones" })!)],
    };
    var form = new UpsertFormModel("contentzones", Model!)
    {
        NodeId = Model?.NodeId,
        IsPublished = Model?.IsPublished == true,
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="container admin-page-body">
    <partial name="_UpsertForm" model="form" />
</div>
