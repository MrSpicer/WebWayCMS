@using WebWayCMS.Models.ContentZone
@model ContentZoneItemsIndexViewModel

@{
    var hasZone = Model.ZoneId != Guid.Empty;
    ViewData["Title"] = hasZone ? $"Items in: {Model.ZoneName}" : "Content Zone Items";
    var listUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="admin-page-header">
    <div class="container is-fluid">
        <div class="admin-page-title-row">
            <div class="admin-page-heading">
                <nav class="breadcrumb" aria-label="breadcrumbs">
                    <ul>
                        <li><a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="contentzones">Content Zones</a></li>
                    </ul>
                </nav>
                <h1 class="title is-5">@ViewData["Title"]</h1>
                @if (!string.IsNullOrEmpty(Model.ZoneDescription))
                {
                    <p class="subtitle is-7 has-text-grey">@Model.ZoneDescription</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="container is-fluid admin-page-body">

        @if (TempData["Error"] != null)
        {
            <div class="notification is-danger">
                @TempData["Error"]
            </div>
        }

        @if (!hasZone)
        {
            <div class="card admin-empty-state">
                <div class="card-content has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light mb-4">
                        <i class="fas fa-puzzle-piece fa-3x" aria-hidden="true"></i>
                    </span>
                    <p class="title is-5">Choose a zone</p>
                    <p class="subtitle is-6 has-text-grey">Zone items are listed per zone: open one from Content Zones.</p>
                </div>
            </div>
        }
        else if (!Model.Items.Any())
        {
            <div class="card admin-empty-state">
                <div class="card-content has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light mb-4">
                        <i class="fas fa-puzzle-piece fa-3x" aria-hidden="true"></i>
                    </span>
                    <p class="title is-5">No items in this zone yet</p>
                    <p class="subtitle is-6 has-text-grey">Use the zone editor to add components.</p>
                </div>
            </div>
        }
        else
        {
            <div class="table-container admin-list-container">
                <table class="table is-fullwidth is-hoverable admin-list-table" id="items-table">
                    <caption class="is-sr-only">Items in content zone @Model.ZoneName</caption>
                    <thead>
                        <tr>
                            <th scope="col" style="width: 60px;">Order</th>
                            <th scope="col">Component</th>
                            <th scope="col" class="is-hidden-mobile">Properties</th>
                            <th scope="col">Active</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items.OrderBy(i => i.Ordinal))
                        {
                            <tr data-item-id="@item.Id">
                                <td><span class="tag">@item.Ordinal</span></td>
                                <td class="admin-list-main">
                                    <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="contentzoneitems" asp-route-id="@item.Id" asp-route-returnUrl="@listUrl" class="admin-list-title">@item.ComponentName</a>
                                </td>
                                <td class="is-hidden-mobile"><code class="is-size-7">@(item.ComponentPropertiesJson.Length > 50 ? item.ComponentPropertiesJson.Substring(0, 50) + "..." : item.ComponentPropertiesJson)</code></td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="tag is-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="tag is-warning">No</span>
                                    }
                                </td>
                                <td>
                                    <div class="admin-row-actions">
                                        <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="contentzoneitems" asp-route-id="@item.Id" asp-route-returnUrl="@listUrl" class="button is-small">
                                            <span class="icon"><i class="fas fa-pencil-alt" aria-hidden="true"></i></span>
                                            <span>Edit</span>
                                        </a>
                                        <div class="dropdown is-right admin-row-menu">
                                            <div class="dropdown-trigger">
                                                <button type="button" class="button is-small admin-row-menu-trigger" data-row-menu-trigger
                                                        aria-haspopup="true" aria-expanded="false" aria-controls="row-menu-@item.Id"
                                                        aria-label="More actions for @item.ComponentName">
                                                    <span class="icon"><i class="fas fa-ellipsis-v" aria-hidden="true"></i></span>
                                                </button>
                                            </div>
                                            <div class="dropdown-menu" id="row-menu-@item.Id" role="menu">
                                                <div class="dropdown-content">
                                                    <button type="button" class="dropdown-item is-danger" role="menuitem"
                                                            data-delete-trigger
                                                            data-delete-name="@item.ComponentName"
                                                            data-delete-url="@Url.Action("Delete", "AdminContent", new { contentType = "contentzoneitems", id = item.Id, returnUrl = listUrl })">
                                                        <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                                        <span>Delete</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="mt-4">
            <a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="contentzones" class="button">Back to Zones</a>
        </div>
</div>
