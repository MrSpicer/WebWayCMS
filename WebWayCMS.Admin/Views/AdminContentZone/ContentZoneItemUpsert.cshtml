@using WebWayCMS.Controllers.Admin
@using WebWayCMS.Models.ContentZone
@model ContentZoneItemUpsertViewModel

@{
    var isNew = Model.NodeId == null || Model.NodeId == Guid.Empty;
    ViewData["Title"] = isNew ? "New Item" : "Edit Item";
    var zoneName = Model.ZoneName ?? "Zone";
    var zoneItemsUrl = Url.Action("Index", "AdminContent", new { contentType = "contentzoneitems" })
        + "?" + ContentZoneItemModel.ZoneQueryKey + "=" + Model.ContentZoneNodeId;
    var header = new AdminPageHeaderModel((string)ViewData["Title"]!)
    {
        Fluid = false,
        NodeId = Model.NodeId,
        Crumbs =
        [
            new AdminCrumb("Content Zones", Url.Action("Index", "AdminContent", new { contentType = "contentzones" })!),
            new AdminCrumb(zoneName, zoneItemsUrl),
        ],
    };
    var form = new UpsertFormModel("contentzoneitems", Model)
    {
        NodeId = Model.NodeId,
        UsePublishActions = false,
        // Always round-trips: a save goes back to where the item was opened from, else the zone's items.
        ReturnUrl = AdminReturnUrl.Resolve(Context.Request, Url) ?? zoneItemsUrl,
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="container admin-page-body">
    <partial name="_UpsertForm" model="form" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
