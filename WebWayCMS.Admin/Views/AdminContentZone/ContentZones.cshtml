@using WebWayCMS.Data.Models
@using WebWayCMS.Models.ContentZone

@model ContentZoneIndexViewModel

@{
    ViewData["Title"] = "Content Zones";
}

<div class="admin-page-header">
    <div class="container">
        <div class="admin-page-title-row">
            <h1 class="title is-4">Content Zones</h1>
            <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="contentzones" class="button is-primary">
                <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
                <span>New Zone</span>
            </a>
        </div>
    </div>
</div>

<section class="section">
<div class="container is-fluid">

        @if (TempData["Error"] != null)
        {
            <div class="notification is-danger" role="alert">
                @TempData["Error"]
            </div>
        }

        @if (Model.FilterPageId.HasValue || Model.FilterParentZoneId.HasValue)
        {
            var label = Model.FilterPageId.HasValue
                ? $"page: {Model.FilterPageRoute ?? Model.FilterPageId.ToString()}"
                : $"zone: {Model.FilterParentZoneName ?? Model.FilterParentZoneId.ToString()}";
            <div class="message is-info mt-4">
                <div class="message-body">
                    Filtered by @label
                    <a href="@Url.Action("Index", "AdminContent", new { contentType = "contentzones" })" class="ml-3 button is-small">Clear filter</a>
                </div>
            </div>
        }

        @if (!Model.Zones.Any())
        {
            <div class="card admin-empty-state mt-4">
                <div class="card-content has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light mb-4">
                        <i class="fas fa-th-large fa-3x" aria-hidden="true"></i>
                    </span>
                    <p class="title is-5">No content zones defined</p>
                    <p class="subtitle is-6 has-text-grey">Create your first content zone to get started.</p>
                    <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="contentzones" class="button is-primary mt-2">New Zone</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-container admin-list-container mt-4">
                <table class="table is-fullwidth is-hoverable admin-list-table">
                    <caption class="is-sr-only">List of content zones</caption>
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="is-hidden-mobile">Modified</th>
                            <th scope="col" class="is-hidden-mobile">Version</th>
                            <th scope="col" class="is-hidden-mobile">Assignments</th>
                            <th scope="col" class="is-hidden-mobile">Global</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var zone in Model.Zones)
                        {
                            <tr>
                                <td class="admin-list-main">
                                    <a href="/wadmin/contentzones/zone-edit/@zone.Version.Node.Id" class="admin-list-title">@zone.Name</a>
                                    @if (!string.IsNullOrEmpty(zone.Description))
                                    {
                                        <span class="admin-list-sub">@zone.Description</span>
                                    }
                                </td>
                                <td><partial name="_StatusBadge" model="((zone.Version.State == ContentVersionState.Published), false)" /></td>
                                <td class="is-hidden-mobile">@zone.Version.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="is-hidden-mobile"><span class="tag is-light">v@(zone.Version.VersionNumber)</span></td>
                                <td class="is-hidden-mobile">@Model.AssignmentCountsByNodeId.GetValueOrDefault(zone.Version.Node.Id, 0)</td>
                                <td class="is-hidden-mobile">
                                    @if (Model.AssignmentCountsByNodeId.GetValueOrDefault(zone.Version.Node.Id, 0) == 0)
                                    {
                                        <span class="tag is-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="tag is-light">No</span>
                                    }
                                </td>
                                <td>
                                    <div class="admin-row-actions">
                                        @if (!(zone.Version.State == ContentVersionState.Published))
                                        {
                                            <form asp-controller="AdminContent" asp-action="Publish" asp-route-contentType="contentzones" asp-route-nodeId="@zone.Version.Node.Id" method="post">
                                                <button type="submit" class="button is-small is-success">
                                                    <span class="icon"><i class="fas fa-upload" aria-hidden="true"></i></span>
                                                    <span>Publish</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="AdminContent" asp-action="Unpublish" asp-route-contentType="contentzones" asp-route-nodeId="@zone.Version.Node.Id" method="post">
                                                <button type="submit" class="button is-small is-warning is-light">
                                                    <span class="icon"><i class="fas fa-eye-slash" aria-hidden="true"></i></span>
                                                    <span>Unpublish</span>
                                                </button>
                                            </form>
                                        }
                                        <a href="/wadmin/contentzones/zone-edit/@zone.Version.Node.Id" class="button is-small">
                                            <span class="icon"><i class="fas fa-th-large" aria-hidden="true"></i></span>
                                            <span>Edit zone</span>
                                        </a>
                                        <div class="dropdown is-right admin-row-menu">
                                            <div class="dropdown-trigger">
                                                <button type="button" class="button is-small admin-row-menu-trigger" data-row-menu-trigger
                                                        aria-haspopup="true" aria-expanded="false" aria-controls="row-menu-@zone.Version.Node.Id"
                                                        aria-label="More actions for @zone.Name">
                                                    <span class="icon"><i class="fas fa-ellipsis-v" aria-hidden="true"></i></span>
                                                </button>
                                            </div>
                                            <div class="dropdown-menu" id="row-menu-@zone.Version.Node.Id" role="menu">
                                                <div class="dropdown-content">
                                                    <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="contentzones" asp-route-id="@zone.Version.Node.Id" class="dropdown-item" role="menuitem">
                                                        <span class="icon"><i class="fas fa-cog" aria-hidden="true"></i></span>
                                                        <span>Settings</span>
                                                    </a>
                                                    @if (Model.ZoneIdsWithChildren.Contains(zone.Version.Node.Id))
                                                    {
                                                        <a href="@Url.Action("Index", "AdminContent", new { contentType = "contentzones" })?zoneId=@zone.Version.Node.Id" class="dropdown-item" role="menuitem">
                                                            <span class="icon"><i class="fas fa-sitemap" aria-hidden="true"></i></span>
                                                            <span>Child zones</span>
                                                        </a>
                                                    }
                                                    <a asp-controller="AdminContent" asp-action="ChildIndex" asp-route-contentType="contentzones" asp-route-parentKey="@zone.Version.Node.Id" asp-route-childType="items" class="dropdown-item" role="menuitem">
                                                        <span class="icon"><i class="fas fa-list" aria-hidden="true"></i></span>
                                                        <span>Items (advanced)</span>
                                                    </a>
                                                    <a asp-controller="AdminContent" asp-action="VersionHistory" asp-route-contentType="contentzones" asp-route-nodeId="@zone.Version.Node.Id" class="dropdown-item" role="menuitem">
                                                        <span class="icon"><i class="fas fa-history" aria-hidden="true"></i></span>
                                                        <span>Version history</span>
                                                    </a>
                                                    <hr class="dropdown-divider" />
                                                    <button type="button" class="dropdown-item is-danger" role="menuitem"
                                                            data-delete-trigger
                                                            data-delete-name="@zone.Name"
                                                            data-delete-url="@Url.Action("Delete", "AdminContent", new { contentType = "contentzones", id = zone.Version.Node.Id })">
                                                        <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                                        <span>Delete</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</div>
</section>
