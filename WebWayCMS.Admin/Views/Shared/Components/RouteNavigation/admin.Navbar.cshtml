@using WebWayCMS.Models.CMSRoute
@model RouteNavigationViewModel

@*
    Bulma navbar items for the admin navbar. _AdminNavbar.cshtml asks for ViewName = "Navbar" and
    renders on /wadmin pages (admin render mode), so this resolves as admin.Navbar. It is a named
    variant, not admin.default, so a RouteNavigation widget placed in a zone on an admin page still
    falls back to its own view.{ViewName} rather than turning into bare navbar links.

    It is separate from the view.* files because a host application's Views/ folder shadows the RCL
    for the whole app — including the admin UI. A host that re-skins
    Components/RouteNavigation/view.default.cshtml for its own CSS framework would otherwise break
    the admin navbar, which only loads Bulma.

    The Bulma navbar has no nested-list styling, so the route tree is flattened in pre-order: a
    parent's link is followed by its children's links, all siblings in the navbar-start
    role="list" (e.g. Dashboard, Users, Roles). Markup matches the hand-written
    <a class="navbar-item"> links in _AdminNavbar.cshtml, including their aria-current="page" on
    the active link.
*@

@foreach (var item in Model.Items)
{
    await RenderNavItem(item);
}

@functions {
    async Task RenderNavItem(RouteNavigationItem item)
    {
        var currentPath = (Context.Request.Path.Value ?? "").TrimEnd('/');
        var isCurrent = string.Equals(currentPath, item.Path.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);

        <a class="navbar-item" href="@item.Path" role="listitem"
           aria-current="@(isCurrent ? "page" : null)">@item.Title</a>
        @foreach (var child in item.Children)
        {
            await RenderNavItem(child);
        }
    }
}
