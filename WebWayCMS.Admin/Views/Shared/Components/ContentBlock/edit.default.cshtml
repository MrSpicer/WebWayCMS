@model WebWayCMS.Models.ContentBlock.ContentBlockViewModel
@*
    Edit-mode counterpart of the ContentBlock public view: the (sanitized) HTML inside a Bulma box
    so it reads correctly inside the admin zone editor.
*@
@if (!string.IsNullOrWhiteSpace(Model?.Content))
{
    <div class="box content">
        @Html.Raw(Model.Content)
    </div>
}
else
{
    <div class="notification is-light has-text-grey">
        <span class="icon"><i class="fas fa-file-alt" aria-hidden="true"></i></span>
        No content.
    </div>
}
