@model WebWayCMS.Models.ContentZone.ContentZoneViewModel
@using WebWayCMS.Models.ContentZone
@using WebWayCMS.ContentZones
@{
    var componentsByCategory = ViewData["ComponentsByCategory"] as IReadOnlyDictionary<string, IReadOnlyList<WidgetRegistrationInfo>>
        ?? new Dictionary<string, IReadOnlyList<WidgetRegistrationInfo>>();

    // Generate a unique ID for this zone's modal (for multiple zones on one page)
    var modalId = $"cz-modal-{Guid.NewGuid():N}";
    var settingsModalId = $"cz-settings-modal-{Guid.NewGuid():N}";
    var containerId = $"cz-container-{Guid.NewGuid():N}";
    var modalTitleId = $"czModalTitle-{Guid.NewGuid():N}";
    var settingsTitleId = $"czSettingsTitle-{Guid.NewGuid():N}";
    var editorReturnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}

@* Zone name identifier for admin *@
<div class="zone-name-header">
    <span class="tag is-light is-small">
        <span class="icon is-small">
            <i class="fas fa-th-large" aria-hidden="true"></i>
        </span>
        <span>@Model.RawZoneName</span>
    </span>
</div>

@if (!Context.Items.ContainsKey("ContentZoneEditAntiForgeryLoaded"))
{
    Context.Items["ContentZoneEditAntiForgeryLoaded"] = true;
    @Html.AntiForgeryToken()
}

@if (!Context.Items.ContainsKey("ContentZoneEditCssLoaded"))
{
    Context.Items["ContentZoneEditCssLoaded"] = true;
    <link rel="stylesheet" href="~/_content/WebWayCMS.Admin/css/content-zone-edit.css" />
}

<div class="content-zone content-zone-edit" id="@containerId" data-zone-name="@Model.Name" data-modal-id="@modalId" data-settings-modal-id="@settingsModalId" data-page-node-id="@(Model.OwnerPageNodeId?.ToString() ?? "")">
    @* Hidden zone ID - never displayed to users *@
    <input type="hidden" class="zone-id-field" value="@Model.Id" />

    @* Render existing zone items *@
    @if (Model.ZoneObjects?.Any() == true)
    {
        foreach (var obj in Model.ZoneObjects.OrderBy(o => o.Ordinal))
        {
            // The item's metadata (cog editor) overrides the toolbar label and adds a note.
            var toolbarLabel = string.IsNullOrWhiteSpace(obj.Metadata.AdminLabel) ? obj.ComponentName : obj.Metadata.AdminLabel;
            var adminNote = string.IsNullOrWhiteSpace(obj.Metadata.AdminNote) ? null : obj.Metadata.AdminNote;
            // Nested zones rendered by this item (e.g. a Layout's columns) are owned by it. WidgetViewComponent
            // also sets this from the item's config; this covers widgets that don't derive from it.
            ViewData["ContentZone:ParentItemId"] = obj.Id;
            <div class="zone-object zone-object-edit" data-item-id="@obj.Id" data-component-name="@obj.ComponentName" data-ordinal="@obj.Ordinal" data-zone-id="@obj.ZoneId" data-version="@obj.VersionNumber">
                <div class="zone-object-toolbar">
                    @* Drag to move within or between this page's zones; arrow keys reorder (content-zone-drag.js). *@
                    <button type="button" class="zone-drag-handle" title="Drag to move · ↑/↓ to reorder" aria-label="Move @toolbarLabel">
                        <span class="icon">
                            <i class="fas fa-grip-vertical" aria-hidden="true"></i>
                        </span>
                    </button>
                    @* Razor encodes attribute values and drops title when adminNote is null. *@
                    <span class="zone-object-label" title="@adminNote">
                        @toolbarLabel
                    </span>
                    @if (adminNote != null)
                    {
                        <span class="zone-object-note" title="@adminNote">@adminNote</span>
                    }
                    <button type="button" class="zone-edit-item" title="Edit @toolbarLabel" aria-label="Edit @toolbarLabel">
                        <span class="icon">
                            <i class="fas fa-edit" aria-hidden="true"></i>
                        </span>
                    </button>
                    <button type="button" class="zone-settings-item" title="Widget settings" aria-label="Widget settings">
                        <span class="icon">
                            <i class="fas fa-cog" aria-hidden="true"></i>
                        </span>
                    </button>
                    @* The item's version history; Back (and restore/delete) return to this editor. parentKey must be
                       a string: the route's notreserved constraint rejects any other value type. *@
                    <a class="zone-history-item" title="History of @toolbarLabel" aria-label="History of @toolbarLabel"
                       href="@Url.Action("ChildVersionHistory", "AdminContent", new { contentType = "contentzones", parentKey = obj.ZoneId.ToString(), childType = "items", nodeId = obj.Id, returnUrl = editorReturnUrl })">
                        <span class="icon">
                            <i class="fas fa-history" aria-hidden="true"></i>
                        </span>
                    </a>
                    <button type="button" class="zone-delete-item" title="Delete @toolbarLabel" aria-label="Delete @toolbarLabel">
                        <span class="icon">
                            <i class="fas fa-trash" aria-hidden="true"></i>
                        </span>
                    </button>
                </div>
                <div class="zone-object-content">
                    @await Component.InvokeAsync(obj.ComponentName, obj.ComponentProperties)
                </div>
            </div>
        }
    }

    @* Add Widget Button *@
    <div class="zone-add-widget">
        <button type="button" class="button is-primary is-outlined is-small zone-add-btn" data-modal="@modalId">
            <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
            <span>Add Widget</span>
        </button>
    </div>
</div>

@* Add Widget Modal *@
<div id="@modalId" class="modal cz-add-modal" role="dialog" aria-modal="true" aria-labelledby="@modalTitleId">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <h2 class="modal-card-title" id="@modalTitleId">Add Widget</h2>
            <button class="delete" aria-label="Close dialog"></button>
        </header>
        <section class="modal-card-body">
            @* Inline error notification — shown by JS on error *@
            <div class="cz-modal-error" role="alert" aria-live="assertive" style="display:none"></div>

            <form class="cz-widget-form" data-container="@containerId">
                @* Hidden fields - IDs are auto-generated, never shown to users *@
                <input type="hidden" name="zoneName" value="@Model.Name" />
                @if (Model.ParentPageNodeId.HasValue)
                {
                    <input type="hidden" name="parentPageNodeId" value="@Model.ParentPageNodeId.Value" />
                    <input type="hidden" name="slotName" value="@Model.RawZoneName" />
                }
                <input type="hidden" name="componentPropertiesJson" class="component-props-json" />

                <div class="field">
                    <label class="label" for="componentSelector-@modalId">Component</label>
                    <div class="control">
                        <div class="select is-fullwidth">
                            <select id="componentSelector-@modalId" name="componentName" class="component-selector" required aria-required="true">
                                <option value="">-- Select a component --</option>
                                @foreach (var category in componentsByCategory.OrderBy(c => c.Key))
                                {
                                    <optgroup label="@category.Key">
                                        @foreach (var component in category.Value.OrderBy(c => c.Order).ThenBy(c => c.DisplayName))
                                        {
                                            <option value="@component.Name" data-description="@component.Description" data-supports-list="@(component.SupportsList ? "true" : "false")">
                                                @component.DisplayName
                                            </option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                    </div>
                    <p class="help component-description">Select a component to configure.</p>
                </div>

                @* Single/List toggle — shown by JS only for widgets that support list mode. Single and
                   List have different configuration fields, so switching re-renders the form. *@
                <div class="field cz-display-mode-field" style="display: none;">
                    <label class="label" id="czDisplayModeLabel-@modalId">Display Mode</label>
                    <div class="buttons has-addons cz-display-mode-toggle" role="group" aria-labelledby="czDisplayModeLabel-@modalId">
                        <button type="button" class="button is-small" data-display-mode="Single" aria-pressed="true">Single item</button>
                        <button type="button" class="button is-small" data-display-mode="List" aria-pressed="false">List</button>
                    </div>
                    <p class="help cz-display-mode-help">Change it later in the widget settings (cog).</p>
                </div>

                <div class="dynamic-properties-container" style="display: none;" aria-live="polite">
                    <hr />
                    <h3 class="subtitle is-5">Configuration</h3>
                    <div class="dynamic-properties">
                        <!-- Dynamic form fields inserted here -->
                    </div>
                </div>
            </form>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button is-success save-widget-btn">Save</button>
            <button type="button" class="button cancel-btn">Cancel</button>
        </footer>
    </div>
</div>

@* Widget settings (metadata) modal — hosts the per-item metadata form (display mode for list-capable
   widgets, admin label/note, CSS class, anchor id), loaded per item from the registry endpoint. *@
<div id="@settingsModalId" class="modal cz-settings-modal" role="dialog" aria-modal="true" aria-labelledby="@settingsTitleId">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <h2 class="modal-card-title" id="@settingsTitleId">Widget Settings</h2>
            <button class="delete" aria-label="Close dialog"></button>
        </header>
        <section class="modal-card-body">
            @* Inline error notification — shown by JS on error *@
            <div class="cz-modal-error" role="alert" aria-live="assertive" style="display:none"></div>

            <form class="cz-settings-form">
                <div class="cz-settings-fields">
                    <!-- Dynamic metadata form fields inserted here -->
                </div>
            </form>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button is-success cz-settings-save">Save</button>
            <button type="button" class="button cancel-btn">Cancel</button>
        </footer>
    </div>
</div>

@if (!Context.Items.ContainsKey("ContentZoneEditJsLoaded"))
{
    Context.Items["ContentZoneEditJsLoaded"] = true;
    <script src="~/_content/WebWayCMS.Admin/js/content-zone-edit.js"></script>
    <script src="~/_content/WebWayCMS.Admin/js/content-zone-drag.js"></script>
}
