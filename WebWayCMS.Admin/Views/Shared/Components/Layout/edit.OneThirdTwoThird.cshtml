@*
    Edit-mode counterpart of view.OneThirdTwoThird: the same slot layout as the public
    view, rendered with Bulma so it reads correctly inside the admin zone editor.
    Nested zones inherit edit mode from the zone that renders this widget.
*@

<div class="columns is-mobile">
    <div class="column is-4">
        <p class="heading is-6 has-text-weight-bold">Sidebar</p>
        @await Component.InvokeAsync("ContentZone", new { zoneName = "Sidebar" })
    </div>
    <div class="column is-8">
        <p class="heading is-6 has-text-weight-bold">Main</p>
        @await Component.InvokeAsync("ContentZone", new { zoneName = "Main" })
    </div>
</div>
