@using WebWayCMS.Controllers.Admin
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // A reference-picker modal renders the same form without the admin chrome (and is framed by the
    // source form's iframe, which relation-modal.js drives).
    var isModal = AdminModal.IsModal(ViewData);
}

<!DOCTYPE html>
<html lang="en" class="admin-html">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	@await RenderSectionAsync("Meta", required: false)
	<title>@ViewData["Title"]</title>

	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	<link rel="stylesheet" href="~/_content/WebWayCMS.Presentation/css/bulma.min.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/_content/WebWayCMS.Admin/css/admin.css" asp-append-version="true" />

	@if (IsSectionDefined("CKEditor"))
	{
		<link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/46.1.1/ckeditor5.css" />
	}

	@await RenderSectionAsync("Styles", required: false)

	<meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
	@* CKEditor license key is read from this meta tag by admin.js — kept out of an inline <script>
	   so the Content-Security-Policy script-src needs no 'unsafe-inline'. *@
	<meta name="ckeditor-license-key" content="@Configuration["CKEditor:LicenseKey"]" />
</head>

<body class="admin-shell" data-admin-modal="@(isModal ? "true" : null)">
	@if (!isModal)
	{
		<a href="#main-content" class="skip-to-content">Skip to main content</a>

		<header class="admin-header" role="banner">
			<partial name="_AdminNavbar" />
		</header>
	}

	<main id="main-content" class="admin-main" tabindex="-1">
		@* A redirect's flash shows once on whichever admin page it lands on (every view, not only the
		   ones that used to render it, so it never lingers to a later page). Not in a modal frame. *@
		@if (!isModal && (TempData["Error"] != null || TempData["Success"] != null))
		{
			<div class="container is-fluid admin-flash">
				@if (TempData["Error"] is { } error)
				{
					<div class="notification is-danger" role="alert">@error</div>
				}
				@if (TempData["Success"] is { } success)
				{
					<div class="notification is-success" role="status">@success</div>
				}
			</div>
		}
		@RenderBody()
		@if (!isModal && ViewData[WebWayCMS.Models.Shared.RelationChildrenPanelViewModel.ViewDataKey] is IReadOnlyList<WebWayCMS.Models.Shared.RelationChildrenPanelViewModel> { Count: > 0 } relationPanels)
		{
			@* The parent's children through each containment targeting its type, under its edit form. *@
			<partial name="~/Views/AdminShared/_RelationChildren.cshtml" model="relationPanels" />
		}
	</main>

	@if (!isModal)
	{
		<partial name="_DeleteConfirmModal" />
	}

	@if (IsSectionDefined("CKEditor"))
	{
		<script src="https://cdn.ckeditor.com/ckeditor5/46.1.1/ckeditor5.umd.js"></script>
	}
	<script src="~/_content/WebWayCMS.Admin/js/admin.js" asp-append-version="true"></script>
	<script src="~/_content/WebWayCMS.Admin/js/form-components.js" asp-append-version="true"></script>
	<script src="~/_content/WebWayCMS.Admin/js/media-picker.js" asp-append-version="true"></script>
	<script src="~/_content/WebWayCMS.Admin/js/relation-modal.js" asp-append-version="true"></script>

	@await RenderSectionAsync("CKEditor", required: false)
	@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
