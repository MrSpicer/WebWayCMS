@* The Publish / Unpublish button of an admin list row: Publish while the item is not live or has pending
   changes, otherwise Unpublish. *@
@model WebWayCMS.Admin.Partials.RowPublishToggleModel

@if (Model.OffersPublish)
{
    <form asp-controller="AdminContent" asp-action="Publish" asp-route-contentType="@Model.ContentType" asp-route-nodeId="@Model.NodeId" method="post">
        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
        {
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        }
        <button type="submit" class="button is-small is-success">
            <span class="icon"><i class="fas fa-upload" aria-hidden="true"></i></span>
            <span>Publish</span>
        </button>
    </form>
}
else
{
    <form asp-controller="AdminContent" asp-action="Unpublish" asp-route-contentType="@Model.ContentType" asp-route-nodeId="@Model.NodeId" method="post">
        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
        {
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        }
        <button type="submit" class="button is-small is-warning is-light">
            <span class="icon"><i class="fas fa-eye-slash" aria-hidden="true"></i></span>
            <span>Unpublish</span>
        </button>
    </form>
}
