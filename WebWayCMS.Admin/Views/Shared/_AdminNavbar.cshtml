@using Microsoft.AspNetCore.Identity
@using WebWayCMS.Models.CMSRoute;
@using WebWayCMS.Data.Services.ContentTypes
@inject SignInManager<IdentityUser> SignInManager
@inject IContentTypeRegistrationService ContentTypeRegistrations
@{
    var currentPath = Context.Request.Path.Value ?? "";
    // Content type entries use the plural names admins gave them (/wadmin/contenttypes).
    var names = await ContentTypeRegistrations.GetPublishedByKeyAsync();
}

<nav class="navbar admin-navbar" role="navigation" aria-label="Administration">
    <div class="navbar-brand">
        @* <a class="navbar-item admin-logo" href="/wadmin" aria-label="CMS Admin Home">
            <span>CMS Admin</span>
        </a> *@
        <button id="adminBurger" class="navbar-burger" aria-label="Toggle navigation menu"   aria-expanded="false"
                aria-controls="adminNav">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>
    </div>

    <div id="adminNav" class="navbar-menu">
        <div class="navbar-start" role="list">
            @* Rendered on an admin page, so the widget resolves admin.{ViewName}: admin.Navbar. *@
            @await Component.InvokeAsync(name: "RouteNavigation", new RouteNavigationConfiguration()
            {
                AdminRoutes = true,
                ViewName = "Navbar"
            })
            <a class="navbar-item" href="/wadmin/pages" @(currentPath.StartsWith("/wadmin/pages") ?
                  "aria-current=\"page\"" : "") role="listitem">
                @names.PluralDisplayNameOr("pages", "Pages")
            </a>
            <a class="navbar-item" href="/wadmin/contentblocks" @(currentPath.StartsWith("/wadmin/contentblocks") ?
                           "aria-current=\"page\"" : "") role="listitem">
                @names.PluralDisplayNameOr("contentblocks", "Content Blocks")
            </a>
            <a class="navbar-item" href="/wadmin/articlelists" @(currentPath.StartsWith("/wadmin/article") ?
                               "aria-current=\"page\"" : "") role="listitem">
                @names.PluralDisplayNameOr("articles", "Articles")
            </a>
            <a class="navbar-item" href="/wadmin/images" @(currentPath.StartsWith("/wadmin/images") ?
                               "aria-current=\"page\"" : "") role="listitem">
                @names.PluralDisplayNameOr("images", "Images")
            </a>
            <div class="navbar-item has-dropdown" id="advancedDropdown" role="listitem">
                <button class="navbar-link" id="advancedDropdownTrigger" aria-expanded="false" aria-controls="advancedDropdownMenu">
                    Advanced
                </button>
                <div class="navbar-dropdown" id="advancedDropdownMenu">
                    <a class="navbar-item" href="/wadmin/widgets" @(currentPath.StartsWith("/wadmin/widgets") ? "aria-current=\"page\"" : "")>
                        @names.PluralDisplayNameOr("widgets", "Widgets")
                    </a>
                    <a class="navbar-item" href="/wadmin/formcomponents" @(currentPath.StartsWith("/wadmin/formcomponents") ?
                            "aria-current=\"page\"" : "")>
                        Form Components
                    </a>
                    <a class="navbar-item" href="/wadmin/pagetypes" @(currentPath.StartsWith("/wadmin/pagetypes") ? "aria-current=\"page\"" : "")>
                        @names.PluralDisplayNameOr("pagetypes", "Page Types")
                    </a>
                    <a class="navbar-item" href="/wadmin/cmsroutes" @(currentPath.StartsWith("/wadmin/cmsroutes") ? "aria-current=\"page\"" : "")>
                        CMS Routes
                    </a>
                    <a class="navbar-item" href="/wadmin/contentzones" @(currentPath.StartsWith("/wadmin/contentzones") ?
                                   "aria-current=\"page\"" : "")>
                        @names.PluralDisplayNameOr("contentzones", "Content Zones")
                    </a>
                    <a class="navbar-item" href="/wadmin/contenttypes" @(currentPath.StartsWith("/wadmin/contenttypes") ? "aria-current=\"page\"" : "")>
                        @names.PluralDisplayNameOr("contenttypes", "Content Types")
                    </a>
                    <a class="navbar-item" href="/wadmin/apitokens" @(currentPath.StartsWith("/wadmin/apitokens") ? "aria-current=\"page\"" : "")>
                        API Tokens
                    </a>
                </div>
            </div>
        </div>

        <div class="navbar-end">
            <a class="navbar-item" href="/" target="_blank" rel="noopener" role="listitem">
                View Site
            </a>
            <partial name="_LoginNavPartial" />
        </div>
    </div>
</nav>