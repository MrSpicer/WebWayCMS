@using Microsoft.AspNetCore.Identity
@using WebWayCMS.Models.Page;
@inject SignInManager<IdentityUser> SignInManager
@{
    var currentPath = Context.Request.Path.Value ?? "";
}

<nav class="navbar admin-navbar" role="navigation" aria-label="Administration">
    <div class="navbar-brand">
        @* <a class="navbar-item admin-logo" href="/wadmin" aria-label="CMS Admin Home">
            <span>CMS Admin</span>
        </a> *@
        <button id="adminBurger" class="navbar-burger" aria-label="Toggle navigation menu"   aria-expanded="false"
                aria-controls="adminNav">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>
    </div>

    <div id="adminNav" class="navbar-menu">
        <div class="navbar-start" role="list">
            @await Component.InvokeAsync(name: "Page", new PageContentZoneConfiguration()
            {
                AdminPages = true,
                ViewName = "Default"
            })
            <a class="navbar-item" href="/wadmin/pages" @(currentPath.StartsWith("/wadmin/pages") ?
                  "aria-current=\"page\"" : "") role="listitem">
                Pages
            </a>
            <a class="navbar-item" href="/wadmin/contentblocks" @(currentPath.StartsWith("/wadmin/contentblocks") ?
                           "aria-current=\"page\"" : "") role="listitem">
                Content Blocks
            </a>
            <a class="navbar-item" href="/wadmin/articles" @(currentPath.StartsWith("/wadmin/articles") ?
                               "aria-current=\"page\"" : "") role="listitem">
                Articles
            </a>
            <div class="navbar-item has-dropdown" id="advancedDropdown" role="listitem">
                <button class="navbar-link" id="advancedDropdownTrigger" aria-expanded="false" aria-controls="advancedDropdownMenu">
                    Advanced
                </button>
                <div class="navbar-dropdown" id="advancedDropdownMenu">
                    <a class="navbar-item" href="/wadmin/widgets" @(currentPath.StartsWith("/wadmin/widgets") ? "aria-current=\"page\"" : "")>
                        Widgets
                    </a>
                    <a class="navbar-item" href="/wadmin/formcomponents" @(currentPath.StartsWith("/wadmin/formcomponents") ?
                            "aria-current=\"page\"" : "")>
                        Form Components
                    </a>
                    <a class="navbar-item" href="/wadmin/pagetypes" @(currentPath.StartsWith("/wadmin/pagetypes") ? "aria-current=\"page\"" : "")>
                        Page Types
                    </a>
                    <a class="navbar-item" href="/wadmin/cmsroutes" @(currentPath.StartsWith("/wadmin/cmsroutes") ? "aria-current=\"page\"" : "")>
                        CMS Routes
                    </a>
                    <a class="navbar-item" href="/wadmin/contentzones" @(currentPath.StartsWith("/wadmin/contentzones") ?
                                   "aria-current=\"page\"" : "")>
                        Content Zones
                    </a>
                </div>
            </div>
        </div>

        <div class="navbar-end">
            <a class="navbar-item" href="/" target="_blank" rel="noopener" role="listitem">
                View Site
            </a>
            <partial name="_LoginNavPartial" />
        </div>
    </div>
</nav>