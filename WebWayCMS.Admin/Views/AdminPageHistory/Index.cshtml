@using WebWayCMS.Models.PageHistory
@model PageHistoryIndexViewModel

@{
    ViewData["Title"] = $"Page history: {Model.PageTitle}";
    var crumb = (Model.PageNodeId, Model.PageTitle, "History", (Guid?)null);
}

<partial name="_Breadcrumb" model="crumb" />

<div class="container is-fluid admin-page-body">

    <p class="has-text-grey mb-3">
        Every change to this page or its widgets records an entry; <strong class="has-text-success">Published</strong>
        entries are what went live. Reverting to any entry restores it as drafts (the revert is recorded too, so it
        can be undone); the live site changes only when you publish.
    </p>
    <div class="buttons mb-4">
        <a asp-controller="AdminContentZone" asp-action="PageZones" asp-route-pageNodeId="@Model.PageNodeId" class="button">Back to editor</a>
    </div>

    @if (Model.TotalCount == 0)
    {
        <div class="notification is-light" role="status">
            No history yet. An entry is recorded every time this page or one of its widgets changes.
        </div>
    }
    else if (Model.Entries.Count == 0)
    {
        <div class="notification is-light" role="status">
            There are no entries this far back.
            <a asp-action="Index" asp-route-pageNodeId="@Model.PageNodeId">Go to the newest entries</a>.
        </div>
    }
    else
    {
        <partial name="_Pager" model="Model" />
        <div class="table-container">
            <table class="table is-fullwidth is-striped">
                <caption class="is-sr-only">Page history for @Model.PageTitle</caption>
                <thead>
                    <tr>
                        <th scope="col">When (UTC)</th>
                        <th scope="col">Change</th>
                        <th scope="col">By</th>
                        <th scope="col">Widgets</th>
                        <th scope="col">Changes</th>
                        <th scope="col"><span class="is-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td>@entry.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@entry.Note</td>
                            <td>
                                @if (entry.CreatedBy.HasValue)
                                {
                                    <span class="has-text-grey-light">@entry.CreatedBy</span>
                                }
                                else
                                {
                                    <span class="has-text-grey-light is-italic">—</span>
                                }
                            </td>
                            <td>@entry.ItemCount</td>
                            <td><partial name="_EntrySummary" model="entry" /></td>
                            <td>
                                <div class="buttons are-small">
                                    <a asp-action="Entry" asp-route-pageNodeId="@Model.PageNodeId" asp-route-entryId="@entry.Id" class="button is-small">View</a>
                                    <a asp-action="Compare" asp-route-pageNodeId="@Model.PageNodeId" asp-route-entryId="@entry.Id" class="button is-small">Compare &amp; revert</a>
                                    <a asp-action="Preview" asp-route-pageNodeId="@Model.PageNodeId" asp-route-entryId="@entry.Id" class="button is-small">Preview</a>
                                    <button type="button" class="button is-small is-danger is-light"
                                            data-delete-trigger
                                            data-delete-name="the history entry from @entry.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC"
                                            data-delete-url="@Url.Action("Delete", "AdminPageHistory", new { pageNodeId = Model.PageNodeId, entryId = entry.Id })">
                                        <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                        <span>Delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model" />
    }

</div>
