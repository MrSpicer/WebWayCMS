@* Shared header of the page-history screens. Model: (page node id, page title, current crumb, entry id or null). *@
@model (Guid PageNodeId, string PageTitle, string Current, Guid? EntryId)
@{
    var crumbs = new List<AdminCrumb>
    {
        new("Pages", Url.Action("Index", "AdminContent", new { contentType = "pages" })!),
        new(Model.PageTitle, Url.Action("PageZones", "AdminContentZone", new { pageNodeId = Model.PageNodeId })!),
    };
    if (Model.EntryId.HasValue)
        crumbs.Add(new("History", Url.Action("Index", "AdminPageHistory", new { pageNodeId = Model.PageNodeId })!));
}

<partial name="_AdminPageHeader" model='new AdminPageHeaderModel((string)ViewData["Title"]!) { Crumbs = crumbs }' />
