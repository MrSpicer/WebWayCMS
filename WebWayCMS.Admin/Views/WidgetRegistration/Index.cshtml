@using WebWayCMS.Models.WidgetRegistration
@using WebWayCMS.ContentZones

@model WidgetRegistrationIndexViewModel

@{
    ViewData["Title"] = "Widget Registrations";
    var newUrl = Url.Action("Create", "AdminContent", new { contentType = "widgets" })!;
}

<partial name="_AdminPageHeader" model='new AdminPageHeaderModel("Widgets") { NewUrl = newUrl, NewLabel = "New Widget" }' />

<div class="container is-fluid admin-page-body">

        @if (!Model.Registrations.Any())
        {
            <partial name="_EmptyState" model='new EmptyStateModel("fa-puzzle-piece", "No widget registrations") { Subtitle = "Register ViewComponents to make them available in content zones.", CreateUrl = newUrl, CreateLabel = "New Widget" }' />
        }
        else
        {
            <div class="table-container admin-list-container">
                <table class="table is-fullwidth is-hoverable admin-list-table">
                    <caption class="is-sr-only">List of widget registrations</caption>
                    <thead>
                        <tr>
                            <th scope="col">Display Name</th>
                            <th scope="col" class="is-hidden-mobile">Component</th>
                            <th scope="col" class="is-hidden-mobile">Category</th>
                            <th scope="col">Active</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="is-hidden-mobile">Version</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in Model.Registrations)
                        {
                            <tr>
                                <td class="admin-list-main">
                                    <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="widgets" asp-route-id="@w.Version.Node.Id" class="admin-list-title">@w.DisplayName</a>
                                    @if (!string.IsNullOrEmpty(w.Description))
                                    {
                                        <span class="admin-list-sub">@w.Description</span>
                                    }
                                </td>
                                <td class="is-hidden-mobile"><code>@w.ComponentName</code></td>
                                <td class="is-hidden-mobile"><span class="tag is-info is-light">@w.Category</span></td>
                                <td>
                                    @if (w.IsActive)
                                    {
                                        <span class="tag is-success is-light">Active</span>
                                    }
                                    else
                                    {
                                        <span class="tag is-warning is-light">Inactive</span>
                                    }
                                </td>
                                <td><partial name="_StatusBadge" model="((w.Version.State == WebWayCMS.Data.Models.ContentVersionState.Published), false)" /></td>
                                <td class="is-hidden-mobile"><span class="tag is-light">v@(w.Version.VersionNumber)</span></td>
                                <td>
                                    <div class="admin-row-actions">
                                        <partial name="_RowPublishToggle" model='new RowPublishToggleModel("widgets", w.Version.Node.Id, w.Version.State == WebWayCMS.Data.Models.ContentVersionState.Published)' />
                                        <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="widgets" asp-route-id="@w.Version.Node.Id" class="button is-small">
                                            <span class="icon"><i class="fas fa-pencil-alt" aria-hidden="true"></i></span>
                                            <span>Edit</span>
                                        </a>
                                        <partial name="_RowMenu" model='new RowMenuModel("widgets", w.Version.Node.Id.ToString(), w.DisplayName)' />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</div>
