@model WebWayCMS.Models.WidgetRegistration.WidgetRegistrationUpsertViewModel

@{
    var isEdit = Model?.NodeId != null && Model.NodeId != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit Widget" : "New Widget";
    var header = new AdminPageHeaderModel((string)ViewData["Title"]!)
    {
        Fluid = false,
        NodeId = Model?.NodeId,
        Crumbs = [new AdminCrumb("Widgets", Url.Action("Index", "AdminContent", new { contentType = "widgets" })!)],
    };
    var form = new UpsertFormModel("widgets", Model!)
    {
        NodeId = Model?.NodeId,
        IsPublished = Model?.IsPublished == true,
        AfterFields = @<text>
            @if (Model != null && Model.NodeId.HasValue)
            {
                <div class="field">
                    <label class="label">List Mode</label>
                    <p>@(Model.SupportsList ? "Supported" : "Not supported")</p>
                    <p class="help">Set by the widget's code (<code>[ContentZoneComponent(SupportsList = true)]</code>); not editable here.</p>
                </div>
            }
        </text>,
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="container admin-page-body">
    <partial name="_UpsertForm" model="form" />
</div>
