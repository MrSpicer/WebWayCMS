@using WebWayCMS.Models.FormComponentRegistration

@model FormComponentRegistrationIndexViewModel

@{
    ViewData["Title"] = "Form Components";
}

<div class="admin-page-header">
    <div class="container">
        <div class="admin-page-title-row">
            <h1 class="title is-4">Form Components</h1>
            <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="formcomponents" class="button is-primary">
                <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
                <span>New Form Component</span>
            </a>
        </div>
    </div>
</div>

<section class="section">
<div class="container is-fluid">

        @if (!Model.Registrations.Any())
        {
            <div class="card admin-empty-state mt-4">
                <div class="card-content has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light mb-4">
                        <i class="fas fa-sliders-h fa-3x" aria-hidden="true"></i>
                    </span>
                    <p class="title is-5">No form component registrations</p>
                    <p class="subtitle is-6 has-text-grey">Register field editors to make them available in admin forms.</p>
                    <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="formcomponents" class="button is-primary mt-2">New Form Component</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-container admin-list-container">
                <table class="table is-fullwidth is-hoverable admin-list-table">
                    <caption class="is-sr-only">List of form component registrations</caption>
                    <thead>
                        <tr>
                            <th scope="col">Display Name</th>
                            <th scope="col" class="is-hidden-mobile">Component</th>
                            <th scope="col" class="is-hidden-mobile">View Component</th>
                            <th scope="col" class="is-hidden-mobile">Category</th>
                            <th scope="col">Default</th>
                            <th scope="col">Active</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Registrations)
                        {
                            <tr>
                                <td class="admin-list-main">
                                    <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="formcomponents" asp-route-id="@f.Id" class="admin-list-title">@f.DisplayName</a>
                                    @if (!string.IsNullOrEmpty(f.Description))
                                    {
                                        <span class="admin-list-sub">@f.Description</span>
                                    }
                                </td>
                                <td class="is-hidden-mobile"><code>@f.ComponentName</code></td>
                                <td class="is-hidden-mobile"><code>@f.ViewComponentName</code></td>
                                <td class="is-hidden-mobile"><span class="tag is-info is-light">@f.Category</span></td>
                                <td>
                                    @if (f.IsDefaultForType)
                                    {
                                        <span class="tag is-success is-light">Default</span>
                                    }
                                </td>
                                <td>
                                    @if (f.IsActive)
                                    {
                                        <span class="tag is-success is-light">Active</span>
                                    }
                                    else
                                    {
                                        <span class="tag is-warning is-light">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="admin-row-actions">
                                        <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="formcomponents" asp-route-id="@f.Id" class="button is-small">
                                            <span class="icon"><i class="fas fa-pencil-alt" aria-hidden="true"></i></span>
                                            <span>Edit</span>
                                        </a>
                                        <div class="dropdown is-right admin-row-menu">
                                            <div class="dropdown-trigger">
                                                <button type="button" class="button is-small admin-row-menu-trigger" data-row-menu-trigger
                                                        aria-haspopup="true" aria-expanded="false" aria-controls="row-menu-@f.Id"
                                                        aria-label="More actions for @f.DisplayName">
                                                    <span class="icon"><i class="fas fa-ellipsis-v" aria-hidden="true"></i></span>
                                                </button>
                                            </div>
                                            <div class="dropdown-menu" id="row-menu-@f.Id" role="menu">
                                                <div class="dropdown-content">
                                                    <button type="button" class="dropdown-item is-danger" role="menuitem"
                                                            data-delete-trigger
                                                            data-delete-name="@f.DisplayName"
                                                            data-delete-url="@Url.Action("Delete", "AdminContent", new { contentType = "formcomponents", id = f.Id })">
                                                        <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                                        <span>Delete</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</div>
</section>
