@model WebWayCMS.Models.FormComponentRegistration.FormComponentRegistrationUpsertViewModel

@{
    var isEdit = Model?.Id != null && Model.Id != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit Form Component" : "New Form Component";
    var header = new AdminPageHeaderModel((string)ViewData["Title"]!)
    {
        Fluid = false,
        NodeId = Model?.Id,
        Crumbs = [new AdminCrumb("Form Components", Url.Action("Index", "AdminContent", new { contentType = "formcomponents" })!)],
    };
    var form = new UpsertFormModel("formcomponents", Model!)
    {
        NodeId = Model?.Id,
        UsePublishActions = false,
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="container admin-page-body">
    <partial name="_UpsertForm" model="form" />
</div>
