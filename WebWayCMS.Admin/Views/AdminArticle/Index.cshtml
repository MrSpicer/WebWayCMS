@using WebWayCMS.Models.Article
@model ArticleListIndexViewModel

@{
    ViewData["Title"] = "Article Lists";
    var newUrl = Url.Action("Create", "AdminContent", new { contentType = "articlelists" })!;
}

<partial name="_AdminPageHeader" model='new AdminPageHeaderModel("Article Lists") { NewUrl = newUrl, NewLabel = "New Article List" }' />

<div class="container is-fluid admin-page-body">

        @if (!Model.ArticleLists.Any())
        {
            <partial name="_EmptyState" model='new EmptyStateModel("fa-list", "No article lists yet") { Subtitle = "Create your first article list to get started.", CreateUrl = newUrl, CreateLabel = "New Article List" }' />
        }
        else
        {
            <div class="table-container admin-list-container">
                <table class="table is-fullwidth is-hoverable admin-list-table">
                    <caption class="is-sr-only">List of article lists</caption>
                    <thead>
                        <tr>
                            <th scope="col">Title</th>
                            <th scope="col" class="is-hidden-mobile">Slug</th>
                            <th scope="col">Articles</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="is-hidden-mobile">Modified</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var list in Model.ArticleLists)
                        {
                            <tr>
                                <td class="admin-list-main">
                                    <a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="articles" asp-route-list="@list.NodeId" class="admin-list-title">@list.Title</a>
                                </td>
                                <td class="is-hidden-mobile">@list.Slug</td>
                                <td><a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="articles" asp-route-list="@list.NodeId" aria-label="@list.ArticleCount article(s) in @list.Title">@list.ArticleCount</a></td>
                                <td><partial name="_StatusBadge" model="(list.IsPublished, false)" /></td>
                                <td class="is-hidden-mobile">@list.ModificationDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div class="admin-row-actions">
                                        <partial name="_RowPublishToggle" model='new RowPublishToggleModel("articlelists", list.NodeId, list.IsPublished)' />
                                        <a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="articles" asp-route-list="@list.NodeId" class="button is-small">
                                            <span class="icon"><i class="fas fa-newspaper" aria-hidden="true"></i></span>
                                            <span>Articles</span>
                                        </a>
                                        @{
                                            var rowMenu = new RowMenuModel("articlelists", list.NodeId.ToString(), list.Title)
                                            {
                                                DeleteName = $"{list.Title} and its {list.ArticleCount} article(s)",
                                                ItemsBefore = @<a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="articlelists" asp-route-id="@list.NodeId" class="dropdown-item" role="menuitem">
                                                    <span class="icon"><i class="fas fa-cog" aria-hidden="true"></i></span>
                                                    <span>Settings</span>
                                                </a>,
                                            };
                                        }
                                        <partial name="_RowMenu" model="rowMenu" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</div>
