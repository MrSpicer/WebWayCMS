@using WebWayCMS.Models.Article
@model ArticleListIndexViewModel

@{
    ViewData["Title"] = "Article Lists";
}

<div class="admin-page-header">
    <div class="container">
        <div class="admin-page-title-row">
            <h1 class="title is-4">Article Lists</h1>
            <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="articles" class="button is-primary">
                <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
                <span>New Article List</span>
            </a>
        </div>
    </div>
</div>

<section class="section">
<div class="container is-fluid">

        @if (!Model.ArticleLists.Any())
        {
            <div class="card admin-empty-state mt-4">
                <div class="card-content has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light mb-4">
                        <i class="fas fa-list fa-3x" aria-hidden="true"></i>
                    </span>
                    <p class="title is-5">No article lists yet</p>
                    <p class="subtitle is-6 has-text-grey">Create your first article list to get started.</p>
                    <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="articles" class="button is-primary mt-2">New Article List</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-container admin-list-container">
                <table class="table is-fullwidth is-hoverable admin-list-table">
                    <caption class="is-sr-only">List of article lists</caption>
                    <thead>
                        <tr>
                            <th scope="col">Title</th>
                            <th scope="col" class="is-hidden-mobile">Slug</th>
                            <th scope="col">Articles</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="is-hidden-mobile">Modified</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var list in Model.ArticleLists)
                        {
                            <tr>
                                <td class="admin-list-main">
                                    <a asp-controller="AdminContent" asp-action="ChildIndex" asp-route-contentType="articles" asp-route-parentKey="@list.Slug" asp-route-childType="articles" class="admin-list-title">@list.Title</a>
                                </td>
                                <td class="is-hidden-mobile">@list.Slug</td>
                                <td>@list.ArticleCount</td>
                                <td><partial name="_StatusBadge" model="(list.IsPublished, false)" /></td>
                                <td class="is-hidden-mobile">@list.ModificationDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div class="admin-row-actions">
                                        @if (!list.IsPublished)
                                        {
                                            <form asp-controller="AdminContent" asp-action="Publish" asp-route-contentType="articles" asp-route-nodeId="@list.NodeId" method="post">
                                                <button type="submit" class="button is-small is-success">
                                                    <span class="icon"><i class="fas fa-upload" aria-hidden="true"></i></span>
                                                    <span>Publish</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="AdminContent" asp-action="Unpublish" asp-route-contentType="articles" asp-route-nodeId="@list.NodeId" method="post">
                                                <button type="submit" class="button is-small is-warning is-light">
                                                    <span class="icon"><i class="fas fa-eye-slash" aria-hidden="true"></i></span>
                                                    <span>Unpublish</span>
                                                </button>
                                            </form>
                                        }
                                        <a asp-controller="AdminContent" asp-action="ChildIndex" asp-route-contentType="articles" asp-route-parentKey="@list.Slug" asp-route-childType="articles" class="button is-small">
                                            <span class="icon"><i class="fas fa-newspaper" aria-hidden="true"></i></span>
                                            <span>Articles</span>
                                        </a>
                                        <div class="dropdown is-right admin-row-menu">
                                            <div class="dropdown-trigger">
                                                <button type="button" class="button is-small admin-row-menu-trigger" data-row-menu-trigger
                                                        aria-haspopup="true" aria-expanded="false" aria-controls="row-menu-@list.NodeId"
                                                        aria-label="More actions for @list.Title">
                                                    <span class="icon"><i class="fas fa-ellipsis-v" aria-hidden="true"></i></span>
                                                </button>
                                            </div>
                                            <div class="dropdown-menu" id="row-menu-@list.NodeId" role="menu">
                                                <div class="dropdown-content">
                                                    <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="articles" asp-route-id="@list.NodeId" class="dropdown-item" role="menuitem">
                                                        <span class="icon"><i class="fas fa-cog" aria-hidden="true"></i></span>
                                                        <span>Settings</span>
                                                    </a>
                                                    <a asp-controller="AdminContent" asp-action="VersionHistory" asp-route-contentType="articles" asp-route-nodeId="@list.NodeId" class="dropdown-item" role="menuitem">
                                                        <span class="icon"><i class="fas fa-history" aria-hidden="true"></i></span>
                                                        <span>Version history</span>
                                                    </a>
                                                    <hr class="dropdown-divider" />
                                                    <button type="button" class="dropdown-item is-danger" role="menuitem"
                                                            data-delete-trigger
                                                            data-delete-name="@list.Title"
                                                            data-delete-url="@Url.Action("Delete", "AdminContent", new { contentType = "articles", id = list.NodeId })">
                                                        <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                                        <span>Delete</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</div>
</section>
