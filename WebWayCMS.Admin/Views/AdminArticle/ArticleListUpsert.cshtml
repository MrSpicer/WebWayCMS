@model WebWayCMS.Models.Article.ArticleListUpsertViewModel

@{
    var isEdit = Model?.NodeId != null && Model.NodeId != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit Article List" : "New Article List";
    var header = new AdminPageHeaderModel((string)ViewData["Title"]!)
    {
        Fluid = false,
        NodeId = Model?.NodeId,
        Crumbs = [new AdminCrumb("Article Lists", Url.Action("Index", "AdminContent", new { contentType = "articlelists" })!)],
    };
    var form = new UpsertFormModel("articlelists", Model!)
    {
        NodeId = Model?.NodeId,
        IsPublished = Model?.IsPublished == true,
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="container admin-page-body">
    <partial name="_UpsertForm" model="form" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
