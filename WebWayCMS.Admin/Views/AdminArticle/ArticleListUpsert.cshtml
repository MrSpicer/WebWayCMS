@model WebWayCMS.Models.Article.ArticleListUpsertViewModel

@{
    var isEdit = Model?.NodeId != null && Model.NodeId != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit Article List" : "New Article List";
}

<div class="admin-page-header">
    <div class="container">
        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="articles">Article Lists</a></li>
                <li class="is-active"><a aria-current="page">@ViewData["Title"]</a></li>
            </ul>
        </nav>
        <h1 class="title is-4 mt-2">@ViewData["Title"]</h1>
    </div>
</div>

<section class="section">
<div class="container">
        <form asp-action="Edit" asp-controller="AdminContent" asp-route-contentType="articles" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div role="alert" aria-live="polite">
                @Html.ValidationSummary(false, "", new { @class = "notification is-danger" })
            </div>
            <div class="card">
                <div class="card-content">
                    <form-fields for="@Model" />
                </div>
                <footer class="card-footer">
                    <div class="card-footer-item is-justify-content-flex-start">
                        <button type="submit" class="button is-primary mr-3">Save as Draft</button>
                        @if (Model != null)
                        {
                            @if (Model.IsPublished)
                            {
                                <button type="submit" class="button is-warning mr-3"
                                        asp-controller="AdminContent" asp-action="Unpublish"
                                        asp-route-contentType="articles" asp-route-nodeId="@Model.NodeId">Unpublish</button>
                            }
                            else
                            {
                                <button type="submit" class="button is-success mr-3" name="submitAction" value="publish">Publish</button>
                            }
                        }
                        <a asp-action="Index" asp-controller="AdminContent" asp-route-contentType="articles" class="button">Cancel</a>
                    </div>
                </footer>
            </div>
        </form>
</div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
