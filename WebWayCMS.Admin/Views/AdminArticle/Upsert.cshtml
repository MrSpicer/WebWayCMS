@model WebWayCMS.Models.Article.ArticleUpsertViewModel

@{
    var isEdit = Model?.NodeId != null && Model.NodeId != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit Article" : "New Article";
    var listId = Model?.ArticleListId is { } id && id != Guid.Empty ? id : (Guid?)null;
    // The list's article index (filtered to this article's list) is both the last crumb and where Cancel goes.
    var articlesUrl = Url.Action("Index", "AdminContent", new { contentType = "articles", list = listId })!;
    var header = new AdminPageHeaderModel((string)ViewData["Title"]!)
    {
        Fluid = false,
        NodeId = Model?.NodeId,
        Crumbs =
        [
            new AdminCrumb("Article Lists", Url.Action("Index", "AdminContent", new { contentType = "articlelists" })!),
            new AdminCrumb("Articles", articlesUrl),
        ],
    };
    var form = new UpsertFormModel("articles", Model!)
    {
        NodeId = Model?.NodeId,
        IsPublished = Model?.IsPublished == true,
        CancelUrl = articlesUrl,
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="container admin-page-body">
    <partial name="_UpsertForm" model="form" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
