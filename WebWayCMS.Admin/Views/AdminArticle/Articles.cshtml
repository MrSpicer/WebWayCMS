@using WebWayCMS.Models.Article
@model ArticleIndexViewModel

@{
    var filtered = Model.SelectedListId.HasValue;
    var listTitle = Model.SelectedListTitle ?? "Unknown list";
    ViewData["Title"] = filtered ? listTitle + " - Articles" : "Articles";
    // Publish/unpublish come back here (filter included); the controller only follows local URLs.
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="admin-page-header">
    <div class="container is-fluid">
        <div class="admin-page-title-row">
            <div class="admin-page-heading">
                <nav class="breadcrumb" aria-label="breadcrumbs">
                    <ul>
                        <li><a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="articlelists">Article Lists</a></li>
                    </ul>
                </nav>
                <h1 class="title is-5">@(filtered ? listTitle + " — Articles" : "Articles")</h1>
            </div>
            <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="articles" asp-route-ArticleListId="@Model.SelectedListId" class="button is-primary is-small">
                <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
                <span>New Article</span>
            </a>
        </div>
        <form method="get" asp-controller="AdminContent" asp-action="Index" asp-route-contentType="articles" class="mt-3">
            <div class="field has-addons">
                <div class="control">
                    <label class="is-sr-only" for="article-list-filter">Article list</label>
                    <div class="select is-small">
                        <select id="article-list-filter" name="list">
                            <option value="">All lists</option>
                            @foreach (var list in Model.ArticleLists)
                            {
                                <option value="@list.NodeId" selected="@(list.NodeId == Model.SelectedListId)">@list.Title</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="control">
                    <button type="submit" class="button is-small">Filter</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="container is-fluid admin-page-body">

        @if (TempData["Error"] != null)
        {
            <div class="notification is-danger" role="alert">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="notification is-success" role="status">
                @TempData["Success"]
            </div>
        }

        @if (!Model.Articles.Any())
        {
            <div class="card admin-empty-state">
                <div class="card-content has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light mb-4">
                        <i class="fas fa-newspaper fa-3x" aria-hidden="true"></i>
                    </span>
                    <p class="title is-5">No articles yet</p>
                    <p class="subtitle is-6 has-text-grey">@(filtered ? "Create the first article in this list." : "Create your first article.")</p>
                    <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="articles" asp-route-ArticleListId="@Model.SelectedListId" class="button is-primary mt-2">New Article</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-container admin-list-container">
                <table class="table is-fullwidth is-hoverable admin-list-table">
                    <caption class="is-sr-only">@(filtered ? "Articles in " + listTitle : "All articles")</caption>
                    <thead>
                        <tr>
                            <th scope="col">Title</th>
                            @if (!filtered)
                            {
                                <th scope="col">List</th>
                            }
                            <th scope="col" class="is-hidden-mobile">Slug</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="is-hidden-mobile">Modified</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var article in Model.Articles)
                        {
                            <tr>
                                <td class="admin-list-main">
                                    <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="articles" asp-route-id="@article.NodeId" class="admin-list-title">@article.Title</a>
                                </td>
                                @if (!filtered)
                                {
                                    <td><a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="articles" asp-route-list="@article.ArticleListId">@article.ArticleListTitle</a></td>
                                }
                                <td class="is-hidden-mobile">@article.Slug</td>
                                <td><partial name="_StatusBadge" model="(article.IsPublished, false)" /></td>
                                <td class="is-hidden-mobile">@article.ModificationDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div class="admin-row-actions">
                                        @if (!article.IsPublished)
                                        {
                                            <form asp-controller="AdminContent" asp-action="Publish" asp-route-contentType="articles" asp-route-nodeId="@article.NodeId" method="post">
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="button is-small is-success">
                                                    <span class="icon"><i class="fas fa-upload" aria-hidden="true"></i></span>
                                                    <span>Publish</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="AdminContent" asp-action="Unpublish" asp-route-contentType="articles" asp-route-nodeId="@article.NodeId" method="post">
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="button is-small is-warning is-light">
                                                    <span class="icon"><i class="fas fa-eye-slash" aria-hidden="true"></i></span>
                                                    <span>Unpublish</span>
                                                </button>
                                            </form>
                                        }
                                        <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="articles" asp-route-id="@article.NodeId" class="button is-small">
                                            <span class="icon"><i class="fas fa-pencil-alt" aria-hidden="true"></i></span>
                                            <span>Edit</span>
                                        </a>
                                        <div class="dropdown is-right admin-row-menu">
                                            <div class="dropdown-trigger">
                                                <button type="button" class="button is-small admin-row-menu-trigger" data-row-menu-trigger
                                                        aria-haspopup="true" aria-expanded="false" aria-controls="row-menu-@article.NodeId"
                                                        aria-label="More actions for @article.Title">
                                                    <span class="icon"><i class="fas fa-ellipsis-v" aria-hidden="true"></i></span>
                                                </button>
                                            </div>
                                            <div class="dropdown-menu" id="row-menu-@article.NodeId" role="menu">
                                                <div class="dropdown-content">
                                                    <a asp-controller="AdminContent" asp-action="VersionHistory" asp-route-contentType="articles" asp-route-nodeId="@article.NodeId" class="dropdown-item" role="menuitem">
                                                        <span class="icon"><i class="fas fa-history" aria-hidden="true"></i></span>
                                                        <span>Version history</span>
                                                    </a>
                                                    <hr class="dropdown-divider" />
                                                    <button type="button" class="dropdown-item is-danger" role="menuitem"
                                                            data-delete-trigger
                                                            data-delete-name="@article.Title"
                                                            data-delete-url="@Url.Action("Delete", "AdminContent", new { contentType = "articles", id = article.NodeId })">
                                                        <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                                        <span>Delete</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</div>
