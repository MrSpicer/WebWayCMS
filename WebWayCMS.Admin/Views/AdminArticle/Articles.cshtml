@using WebWayCMS.Models.Article
@model ArticleListViewModel

@{
    ViewData["Title"] = Model.ArticleListTitle + " - Articles";
}

<div class="admin-page-header">
    <div class="container">
        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="articles">Article Lists</a></li>
                <li class="is-active"><a aria-current="page">@Model.ArticleListTitle</a></li>
            </ul>
        </nav>
        <div class="admin-page-title-row">
            <h1 class="title is-4">@Model.ArticleListTitle — Articles</h1>
            <a asp-controller="AdminContent" asp-action="ChildCreate" asp-route-contentType="articles" asp-route-parentKey="@Model.ArticleListSlug" asp-route-childType="articles" class="button is-primary">
                <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
                <span>New Article</span>
            </a>
        </div>
    </div>
</div>

<section class="section">
<div class="container is-fluid">

        @if (!Model.Articles.Any())
        {
            <div class="card admin-empty-state mt-4">
                <div class="card-content has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light mb-4">
                        <i class="fas fa-newspaper fa-3x" aria-hidden="true"></i>
                    </span>
                    <p class="title is-5">No articles yet</p>
                    <p class="subtitle is-6 has-text-grey">Create your first article in this list.</p>
                    <a asp-controller="AdminContent" asp-action="ChildCreate" asp-route-contentType="articles" asp-route-parentKey="@Model.ArticleListSlug" asp-route-childType="articles" class="button is-primary mt-2">New Article</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-container admin-list-container">
                <table class="table is-fullwidth is-hoverable admin-list-table">
                    <caption class="is-sr-only">Articles in @Model.ArticleListTitle</caption>
                    <thead>
                        <tr>
                            <th scope="col">Title</th>
                            <th scope="col" class="is-hidden-mobile">Slug</th>
                            <th scope="col" class="is-hidden-mobile">Created</th>
                            <th scope="col" class="is-hidden-mobile">Modified</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var article in Model.Articles)
                        {
                            <tr>
                                <td class="admin-list-main">
                                    <a asp-controller="AdminContent" asp-action="ChildEdit" asp-route-contentType="articles" asp-route-parentKey="@Model.ArticleListSlug" asp-route-childType="articles" asp-route-id="@article.NodeId" class="admin-list-title">@article.Title</a>
                                </td>
                                <td class="is-hidden-mobile">@article.Slug</td>
                                <td class="is-hidden-mobile">@article.CreationDate?.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="is-hidden-mobile">@article.ModificationDate?.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div class="admin-row-actions">
                                        <a asp-controller="AdminContent" asp-action="ChildEdit" asp-route-contentType="articles" asp-route-parentKey="@Model.ArticleListSlug" asp-route-childType="articles" asp-route-id="@article.NodeId" class="button is-small">
                                            <span class="icon"><i class="fas fa-pencil-alt" aria-hidden="true"></i></span>
                                            <span>Edit</span>
                                        </a>
                                        <div class="dropdown is-right admin-row-menu">
                                            <div class="dropdown-trigger">
                                                <button type="button" class="button is-small admin-row-menu-trigger" data-row-menu-trigger
                                                        aria-haspopup="true" aria-expanded="false" aria-controls="row-menu-@article.NodeId"
                                                        aria-label="More actions for @article.Title">
                                                    <span class="icon"><i class="fas fa-ellipsis-v" aria-hidden="true"></i></span>
                                                </button>
                                            </div>
                                            <div class="dropdown-menu" id="row-menu-@article.NodeId" role="menu">
                                                <div class="dropdown-content">
                                                    @if (article.NodeId.HasValue)
                                                    {
                                                        <a asp-controller="AdminContent" asp-action="ChildVersionHistory" asp-route-contentType="articles" asp-route-parentKey="@Model.ArticleListSlug" asp-route-childType="articles" asp-route-nodeId="@article.NodeId" class="dropdown-item" role="menuitem">
                                                            <span class="icon"><i class="fas fa-history" aria-hidden="true"></i></span>
                                                            <span>Version history</span>
                                                        </a>
                                                    }
                                                    <hr class="dropdown-divider" />
                                                    <button type="button" class="dropdown-item is-danger" role="menuitem"
                                                            data-delete-trigger
                                                            data-delete-name="@article.Title"
                                                            data-delete-url="@Url.Action("ChildDelete", "AdminContent", new { contentType = "articles", parentKey = Model.ArticleListSlug, childType = "articles", id = article.NodeId })">
                                                        <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                                        <span>Delete</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</div>
</section>
