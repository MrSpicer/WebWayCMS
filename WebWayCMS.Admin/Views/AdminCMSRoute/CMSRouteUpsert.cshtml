@model WebWayCMS.Models.CMSRoute.CMSRouteUpsertViewModel

@{
    var isEdit = Model?.Id != null && Model.Id != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit CMS Route" : "New CMS Route";
    var header = new AdminPageHeaderModel((string)ViewData["Title"]!)
    {
        Fluid = false,
        NodeId = Model?.Id,
        Crumbs = [new AdminCrumb("CMS Routes", Url.Action("Index", "AdminContent", new { contentType = "cmsroutes" })!)],
    };
    var form = new UpsertFormModel("cmsroutes", Model!)
    {
        NodeId = Model?.Id,
        UsePublishActions = false,
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="container admin-page-body">
    <partial name="_UpsertForm" model="form" />
</div>
