@using WebWayCMS.Models.CMSRoute

@model CMSRouteUpsertViewModel

@{
    var isEdit = Model?.Id != null && Model.Id != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit CMS Route" : "New CMS Route";
}

<div class="admin-page-header">
    <div class="container">
        <div class="admin-page-title-row">
            <div class="admin-page-heading">
                <nav class="breadcrumb" aria-label="breadcrumbs">
                    <ul>
                        <li><a asp-action="Index" asp-controller="AdminContent" asp-route-contentType="cmsroutes">CMS Routes</a></li>
                    </ul>
                </nav>
                <h1 class="title is-5">@ViewData["Title"]</h1>
                @if (isEdit)
                {
                    <p class="subtitle is-7 has-text-grey"><code class="is-size-7" title="@Model?.Id">@Model?.Id</code></p>
                }
            </div>
        </div>
    </div>
</div>

<div class="container admin-page-body">
        <form asp-action="Edit" asp-controller="AdminContent" asp-route-contentType="cmsroutes" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div role="alert" aria-live="polite">
                @Html.ValidationSummary(false, "", new { @class = "notification is-danger" })
            </div>
            @{
                var returnUrl = ViewData["ReturnUrl"] as string ?? Context.Request.Query["returnUrl"].FirstOrDefault();
            }
            @if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }
            <div class="card">
                <div class="card-content">
                    <form-fields for="@Model" />
                </div>
                <footer class="card-footer">
                    <div class="card-footer-item is-justify-content-flex-start">
                        <button class="button is-primary mr-3" type="submit">Save</button>
                        @if (!string.IsNullOrWhiteSpace(returnUrl))
                        {
                            <a href="@returnUrl" class="button">Cancel</a>
                        }
                        else
                        {
                            <a asp-action="Index" asp-controller="AdminContent" asp-route-contentType="cmsroutes" class="button">Cancel</a>
                        }
                    </div>
                </footer>
            </div>
        </form>
</div>
