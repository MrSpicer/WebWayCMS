@using WebWayCMS.Models.CMSRoute

@model CMSRouteIndexViewModel

@{
    ViewData["Title"] = "CMS Routes";
}

<div class="admin-page-header">
    <div class="container">
        <div class="admin-page-title-row">
            <h1 class="title is-4">CMS Routes</h1>
            <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="cmsroutes" class="button is-primary">
                <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
                <span>New Route</span>
            </a>
        </div>
    </div>
</div>

<section class="section">
<div class="container is-fluid">

        @if (!Model.Routes.Any())
        {
            <div class="card admin-empty-state mt-4">
                <div class="card-content has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light mb-4">
                        <i class="fas fa-route fa-3x" aria-hidden="true"></i>
                    </span>
                    <p class="title is-5">No routes yet</p>
                    <p class="subtitle is-6 has-text-grey">Create routes to map URL patterns to controllers.</p>
                    <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="cmsroutes" class="button is-primary mt-2">New Route</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-container admin-list-container">
                <table class="table is-fullwidth is-hoverable admin-list-table">
                    <caption class="is-sr-only">List of CMS routes</caption>
                    <thead>
                        <tr>
                            <th scope="col">Pattern</th>
                            <th scope="col" class="is-hidden-mobile">Navigation Name</th>
                            <th scope="col" class="is-hidden-mobile">Owning Type</th>
                            <th scope="col">Reserved</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var route in Model.Routes)
                        {
                            <tr>
                                <td class="admin-list-main">
                                    <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="cmsroutes" asp-route-id="@route.Id" class="admin-list-title"><code>@route.Pattern</code></a>
                                </td>
                                <td class="is-hidden-mobile">
                                    @if (string.IsNullOrWhiteSpace(route.NavigationName))
                                    {
                                        <span class="has-text-grey-light">&mdash;</span>
                                    }
                                    else
                                    {
                                        @route.NavigationName
                                    }
                                </td>
                                <td class="is-hidden-mobile">@route.OwningContentType</td>
                                <td>
                                    @if (route.IsReserved)
                                    {
                                        <span class="tag is-warning">Reserved</span>
                                    }
                                </td>
                                <td>
                                    <div class="admin-row-actions">
                                        @if (!route.IsReserved && !route.Pattern.Contains('{') && !route.Pattern.StartsWith("/wadmin", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <a href="@route.Pattern" target="_blank" rel="noopener" class="button is-small is-light">
                                                <span class="icon"><i class="fas fa-external-link-alt" aria-hidden="true"></i></span>
                                                <span>View</span>
                                            </a>
                                        }
                                        <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="cmsroutes" asp-route-id="@route.Id" class="button is-small">
                                            <span class="icon"><i class="fas fa-pencil-alt" aria-hidden="true"></i></span>
                                            <span>Edit</span>
                                        </a>
                                        <div class="dropdown is-right admin-row-menu">
                                            <div class="dropdown-trigger">
                                                <button type="button" class="button is-small admin-row-menu-trigger" data-row-menu-trigger
                                                        aria-haspopup="true" aria-expanded="false" aria-controls="row-menu-@route.Id"
                                                        aria-label="More actions for @route.Pattern">
                                                    <span class="icon"><i class="fas fa-ellipsis-v" aria-hidden="true"></i></span>
                                                </button>
                                            </div>
                                            <div class="dropdown-menu" id="row-menu-@route.Id" role="menu">
                                                <div class="dropdown-content">
                                                    <button type="button" class="dropdown-item is-danger" role="menuitem"
                                                            data-delete-trigger
                                                            data-delete-name="@route.Pattern"
                                                            data-delete-url="@Url.Action("Delete", "AdminContent", new { contentType = "cmsroutes", id = route.Id })">
                                                        <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                                        <span>Delete</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</div>
</section>
