@using WebWayCMS.Models.PageControllerRegistration

@model PageControllerRegistrationIndexViewModel

@{
    ViewData["Title"] = "Page Types";
}

<div class="admin-page-header">
    <div class="container">
        <div class="admin-page-title-row">
            <h1 class="title is-4">Page Types</h1>
            <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="pagetypes" class="button is-primary">
                <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
                <span>New Page Type</span>
            </a>
        </div>
    </div>
</div>

<section class="section">
<div class="container is-fluid">

        @if (!Model.Registrations.Any())
        {
            <div class="card admin-empty-state mt-4">
                <div class="card-content has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light mb-4">
                        <i class="fas fa-file-code fa-3x" aria-hidden="true"></i>
                    </span>
                    <p class="title is-5">No page type registrations</p>
                    <p class="subtitle is-6 has-text-grey">Register page controllers to make them available as page types.</p>
                    <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="pagetypes" class="button is-primary mt-2">New Page Type</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-container admin-list-container">
                <table class="table is-fullwidth is-hoverable admin-list-table">
                    <caption class="is-sr-only">List of page controller registrations</caption>
                    <thead>
                        <tr>
                            <th scope="col">Display Name</th>
                            <th scope="col" class="is-hidden-mobile">Controller</th>
                            <th scope="col" class="is-hidden-mobile">Category</th>
                            <th scope="col">Active</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="is-hidden-mobile">Version</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Registrations)
                        {
                            <tr>
                                <td class="admin-list-main">
                                    <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="pagetypes" asp-route-id="@p.Version.Node.Id" class="admin-list-title">@p.DisplayName</a>
                                    @if (!string.IsNullOrEmpty(p.Description))
                                    {
                                        <span class="admin-list-sub">@p.Description</span>
                                    }
                                </td>
                                <td class="is-hidden-mobile"><code>@p.ControllerName</code></td>
                                <td class="is-hidden-mobile"><span class="tag is-info is-light">@p.Category</span></td>
                                <td>
                                    @if (p.IsActive)
                                    {
                                        <span class="tag is-success is-light">Active</span>
                                    }
                                    else
                                    {
                                        <span class="tag is-warning is-light">Inactive</span>
                                    }
                                </td>
                                <td><partial name="_StatusBadge" model="((p.Version.State == WebWayCMS.Data.Models.ContentVersionState.Published), false)" /></td>
                                <td class="is-hidden-mobile"><span class="tag is-light">v@(p.Version.VersionNumber)</span></td>
                                <td>
                                    <div class="admin-row-actions">
                                        @if (!(p.Version.State == WebWayCMS.Data.Models.ContentVersionState.Published))
                                        {
                                            <form asp-controller="AdminContent" asp-action="Publish" asp-route-contentType="pagetypes" asp-route-nodeId="@p.Version.Node.Id" method="post">
                                                <button type="submit" class="button is-small is-success">
                                                    <span class="icon"><i class="fas fa-upload" aria-hidden="true"></i></span>
                                                    <span>Publish</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="AdminContent" asp-action="Unpublish" asp-route-contentType="pagetypes" asp-route-nodeId="@p.Version.Node.Id" method="post">
                                                <button type="submit" class="button is-small is-warning is-light">
                                                    <span class="icon"><i class="fas fa-eye-slash" aria-hidden="true"></i></span>
                                                    <span>Unpublish</span>
                                                </button>
                                            </form>
                                        }
                                        <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="pagetypes" asp-route-id="@p.Version.Node.Id" class="button is-small">
                                            <span class="icon"><i class="fas fa-pencil-alt" aria-hidden="true"></i></span>
                                            <span>Edit</span>
                                        </a>
                                        <div class="dropdown is-right admin-row-menu">
                                            <div class="dropdown-trigger">
                                                <button type="button" class="button is-small admin-row-menu-trigger" data-row-menu-trigger
                                                        aria-haspopup="true" aria-expanded="false" aria-controls="row-menu-@p.Version.Node.Id"
                                                        aria-label="More actions for @p.DisplayName">
                                                    <span class="icon"><i class="fas fa-ellipsis-v" aria-hidden="true"></i></span>
                                                </button>
                                            </div>
                                            <div class="dropdown-menu" id="row-menu-@p.Version.Node.Id" role="menu">
                                                <div class="dropdown-content">
                                                    <a asp-controller="AdminContent" asp-action="VersionHistory" asp-route-contentType="pagetypes" asp-route-nodeId="@p.Version.Node.Id" class="dropdown-item" role="menuitem">
                                                        <span class="icon"><i class="fas fa-history" aria-hidden="true"></i></span>
                                                        <span>Version history</span>
                                                    </a>
                                                    <hr class="dropdown-divider" />
                                                    <button type="button" class="dropdown-item is-danger" role="menuitem"
                                                            data-delete-trigger
                                                            data-delete-name="@p.DisplayName"
                                                            data-delete-url="@Url.Action("Delete", "AdminContent", new { contentType = "pagetypes", id = p.Version.Node.Id })">
                                                        <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                                        <span>Delete</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</div>
</section>
