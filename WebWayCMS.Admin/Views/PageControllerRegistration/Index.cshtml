@using WebWayCMS.Models.PageControllerRegistration

@model PageControllerRegistrationIndexViewModel

@{
    ViewData["Title"] = "Page Types";
}

<div class="admin-page-header">
    <div class="container">
        <div class="admin-page-title-row">
            <h1 class="title is-4">Page Types</h1>
            <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="pagetypes" class="button is-primary">
                <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
                <span>New Page Type</span>
            </a>
        </div>
    </div>
</div>

<section class="section">
<div class="container is-fluid">

        @if (!Model.Registrations.Any())
        {
            <div class="card admin-empty-state mt-4">
                <div class="card-content has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light mb-4">
                        <i class="fas fa-file-code fa-3x" aria-hidden="true"></i>
                    </span>
                    <p class="title is-5">No page type registrations</p>
                    <p class="subtitle is-6 has-text-grey">Register page controllers to make them available as page types.</p>
                    <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="pagetypes" class="button is-primary mt-2">New Page Type</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="table is-fullwidth is-striped">
                    <caption class="is-sr-only">List of page controller registrations</caption>
                    <thead>
                        <tr>
                            <th scope="col">Display Name</th>
                            <th scope="col">Controller</th>
                            <th scope="col">Category</th>
                            <th scope="col">Active</th>
                            <th scope="col">Version</th>
                            <th scope="col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Registrations)
                        {
                            <tr>
                                <td>
                                    @p.DisplayName
                                    @if (!string.IsNullOrEmpty(p.Description))
                                    {
                                        <br /><small class="has-text-grey">@p.Description</small>
                                    }
                                </td>
                                <td><code>@p.ControllerName</code></td>
                                <td><span class="tag is-info is-light">@p.Category</span></td>
                                <td>
                                    @if (p.IsActive)
                                    {
                                        <span class="tag is-success is-light">Active</span>
                                    }
                                    else
                                    {
                                        <span class="tag is-warning is-light">Inactive</span>
                                    }
                                </td>
                                <td><span class="tag is-light">v@(p.Version.VersionNumber)</span></td>
                                <td>
                                    <div class="buttons are-small">
                                        <a asp-controller="AdminContent" asp-action="VersionHistory" asp-route-contentType="pagetypes" asp-route-nodeId="@p.Version.Node.Id" class="button is-small is-info is-light">Versions</a>
                                        <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="pagetypes" asp-route-id="@p.Version.Node.Id" class="button is-small">Edit</a>
                                        @if (!(p.Version.State == WebWayCMS.Data.Models.ContentVersionState.Published))
                                        {
                                            <form asp-controller="AdminContent" asp-action="Publish" asp-route-contentType="pagetypes" asp-route-nodeId="@p.Version.Node.Id" method="post" class="is-inline-block">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="button is-small is-success">Publish</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="AdminContent" asp-action="Unpublish" asp-route-contentType="pagetypes" asp-route-nodeId="@p.Version.Node.Id" method="post" class="is-inline-block">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="button is-small is-warning">Unpublish</button>
                                            </form>
                                        }
                                        <button type="button" class="button is-small is-danger is-light"
                                                data-delete-trigger
                                                data-delete-name="@p.DisplayName"
                                                data-delete-url="@Url.Action("Delete", "AdminContent", new { contentType = "pagetypes", id = p.Version.Node.Id })">
                                            <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                            <span>Delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</div>
</section>
