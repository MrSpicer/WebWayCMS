@model WebWayCMS.Models.Route.RouteUpsertViewModel

@{
    var isEdit = Model?.NodeId != null && Model.NodeId != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit Route" : "New Route";
    var header = new AdminPageHeaderModel((string)ViewData["Title"]!)
    {
        Fluid = false,
        NodeId = Model?.NodeId,
        Crumbs = [new AdminCrumb("Routes", Url.Action("Index", "AdminContent", new { contentType = "routes" })!)],
    };
    var form = new UpsertFormModel("routes", Model!)
    {
        NodeId = Model?.NodeId,
        UsePublishActions = false,
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="container admin-page-body">
    <partial name="_UpsertForm" model="form" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
