@model WebWayCMS.Models.Route.RouteUpsertViewModel
@{
    var isEdit = Model?.NodeId != null && Model.NodeId != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit Route" : "New Route";
}

<div class="admin-page-header">
    <div class="container">
        <div class="admin-page-title-row">
            <div class="admin-page-heading">
                <nav class="breadcrumb" aria-label="breadcrumbs">
                    <ul><li><a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="routes">Routes</a></li></ul>
                </nav>
                <h1 class="title is-5">@ViewData["Title"]</h1>
            </div>
        </div>
    </div>
</div>

<div class="container admin-page-body">
    <form asp-action="Edit" asp-controller="AdminContent" asp-route-contentType="routes" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div role="alert" aria-live="polite">
            @Html.ValidationSummary(false, "", new { @class = "notification is-danger" })
        </div>
        <div class="card">
            <div class="card-content">
                <form-fields for="@Model" />
            </div>
            <footer class="card-footer">
                <div class="card-footer-item is-justify-content-flex-start">
                    <button type="submit" class="button is-primary mr-3">Save</button>
                    <a asp-action="Index" asp-controller="AdminContent" asp-route-contentType="routes" class="button">Cancel</a>
                </div>
            </footer>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
