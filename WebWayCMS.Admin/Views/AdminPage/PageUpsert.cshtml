@using WebWayCMS.Models.Page
@model PageUpsertViewModel

@{
    var isNew = Model.NodeId == null || Model.NodeId == Guid.Empty;
    ViewData["Title"] = isNew ? "Create Page" : "Edit Page";
}

<div class="admin-page-header">
    <div class="container">
        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="pages">Pages</a></li>
                <li class="is-active"><a href="#" aria-current="page">@(isNew ? "Create" : "Edit")</a></li>
            </ul>
        </nav>
        <h1 class="title is-4 mt-2">@ViewData["Title"]</h1>
    </div>
</div>

<section class="section">
<div class="container">
        <form asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="pages" method="post" id="pageForm"
              data-controller="@Model.ControllerName"
              data-view-name="@Model.ViewName"
              novalidate>
            @Html.AntiForgeryToken()

            <div role="alert" aria-live="polite">
                @Html.ValidationSummary(false, "", new { @class = "notification is-danger" })
            </div>

            <div class="card">
                <div class="card-content">
                    <form-fields for="@Model" />

                    <div id="configurationArea" class="is-hidden">
                        <h2 id="configurationHeading" class="subtitle mt-4">Configuration</h2>
                        <p class="help mb-3">These settings belong to the selected page type and will be applied when the page renders.</p>
                        <div id="configFields"></div>
                    </div>
                </div>
                <footer class="card-footer">
                    <div class="card-footer-item is-justify-content-flex-start">
                        <button class="button is-primary mr-3" type="submit">Save as Draft</button>
                        @if (Model.IsPublished)
                        {
                            <button type="submit" class="button is-warning mr-3"
                                    asp-controller="AdminContent" asp-action="Unpublish"
                                    asp-route-contentType="pages" asp-route-nodeId="@Model.NodeId">Unpublish</button>
                        }
                        else
                        {
                            <button type="submit" class="button is-success mr-3" name="submitAction" value="publish">Publish</button>
                        }
                        <a asp-controller="AdminContent" asp-action="Index" asp-route-contentType="pages" class="button">Cancel</a>
                    </div>
                </footer>
            </div>
        </form>
</div>
</section>

<script src="~/_content/WebWayCMS.Admin/js/page-upsert.js"></script>
