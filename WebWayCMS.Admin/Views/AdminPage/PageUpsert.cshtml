@using WebWayCMS.Models.Page
@model PageUpsertViewModel

@{
    var isEdit = Model?.NodeId != null && Model.NodeId != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit Page" : "Create Page";
    var header = new AdminPageHeaderModel((string)ViewData["Title"]!)
    {
        Fluid = false,
        NodeId = Model?.NodeId,
        Crumbs = [new AdminCrumb("Pages", Url.Action("Index", "AdminContent", new { contentType = "pages" })!)],
    };
    var form = new UpsertFormModel("pages", Model!)
    {
        NodeId = Model?.NodeId,
        IsPublished = Model?.IsPublished == true,
        FormId = "pageForm",
        // Filled by page-upsert.js with the selected page type's configuration fields.
        AfterFields = @<div id="configurationArea" class="is-hidden">
                           <h2 id="configurationHeading" class="subtitle mt-4">Configuration</h2>
                           <p class="help mb-3">These settings belong to the selected page type and will be applied when the page renders.</p>
                           <div id="configFields"></div>
                       </div>,
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="container admin-page-body">
    <partial name="_UpsertForm" model="form" />
</div>

@section Scripts {
    <script src="~/_content/WebWayCMS.Admin/js/page-upsert.js" asp-append-version="true"></script>
}
