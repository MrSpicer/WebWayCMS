@using WebWayCMS.Models.Page

@model PageIndexViewModel

@{
    ViewData["Title"] = "Pages";
}

<div class="admin-page-header">
    <div class="container is-fluid">
        <div class="admin-page-title-row">
            <h1 class="title is-5">Pages</h1>
            <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="pages" class="button is-primary is-small">
                <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
                <span>New Page</span>
            </a>
        </div>
    </div>
</div>

<div class="container is-fluid admin-page-body">

        @if (!Model.Pages.Any())
        {
            <div class="card admin-empty-state">
                <div class="card-content has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light mb-4">
                        <i class="fas fa-file-alt fa-3x" aria-hidden="true"></i>
                    </span>
                    <p class="title is-5">No pages yet</p>
                    <p class="subtitle is-6 has-text-grey">Create your first page to get started.</p>
                    <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="pages" class="button is-primary mt-2">New Page</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-container admin-list-container">
                <table class="table is-fullwidth is-hoverable admin-list-table">
                    <caption class="is-sr-only">List of pages</caption>
                    <thead>
                        <tr>
                            <th scope="col">Page</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="is-hidden-mobile">Modified</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ await RenderTreeNodes(Model.Pages, 0); }
                    </tbody>
                </table>
            </div>
        }

</div>

@functions {
    async Task RenderTreeNodes(List<PageTreeNode> nodes, int depth)
    {
        foreach (var node in nodes)
        {
            var menuId = $"page-menu-{node.PageNodeId ?? Guid.NewGuid()}";
            <tr>
                <td class="admin-list-main">
                    <div style="margin-left: @((depth > 0 ? (depth - 1) * 1.25 : 0).ToString(System.Globalization.CultureInfo.InvariantCulture))rem;">
                        <div class="@(depth > 0 ? "admin-tree-indent" : "")">
                            @if (node.PageNodeId.HasValue)
                            {
                                <a asp-controller="AdminContentZone" asp-action="PageZones" asp-route-pageNodeId="@node.PageNodeId"
                                   class="admin-list-title">@node.Title</a>
                                <span class="admin-list-sub admin-list-path">@node.Path</span>
                            }
                            else
                            {
                                <span class="admin-list-sub admin-list-path">@node.Path</span>
                                <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="pages" asp-route-parentRoute="@node.Path"
                                   class="is-size-7">
                                    <span class="icon is-small"><i class="fas fa-plus" aria-hidden="true"></i></span>
                                    Add page here
                                </a>
                            }
                        </div>
                    </div>
                </td>
                <td>
                    @if (node.PageNodeId.HasValue)
                    {
                        <partial name="_StatusBadge" model="(node.IsPublished, node.HasPendingChanges)" />
                    }
                </td>
                <td class="is-hidden-mobile">@node.ModificationDate?.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (node.PageNodeId.HasValue)
                    {
                        <div class="admin-row-actions">
                            @if (node.IsPublished)
                            {
                                <a href="@node.Path" target="_blank" rel="noopener" class="button is-small is-light">
                                    <span class="icon"><i class="fas fa-external-link-alt" aria-hidden="true"></i></span>
                                    <span>View</span>
                                </a>
                            }
                            @* One publish button: Publish while anything is pending, otherwise Unpublish. *@
                            @if (!node.IsPublished || node.HasPendingChanges)
                            {
                                <form asp-controller="AdminContent" asp-action="Publish" asp-route-contentType="pages" asp-route-nodeId="@node.PageNodeId" method="post">
                                    <button type="submit" class="button is-small is-success">
                                        <span class="icon"><i class="fas fa-upload" aria-hidden="true"></i></span>
                                        <span>Publish</span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="AdminContent" asp-action="Unpublish" asp-route-contentType="pages" asp-route-nodeId="@node.PageNodeId" method="post">
                                    <button type="submit" class="button is-small is-warning is-light">
                                        <span class="icon"><i class="fas fa-eye-slash" aria-hidden="true"></i></span>
                                        <span>Unpublish</span>
                                    </button>
                                </form>
                            }
                            <a asp-controller="AdminContentZone" asp-action="PageZones" asp-route-pageNodeId="@node.PageNodeId" class="button is-small">
                                <span class="icon"><i class="fas fa-th-large" aria-hidden="true"></i></span>
                                <span>Edit zones</span>
                            </a>
                            <div class="dropdown is-right admin-row-menu">
                                <div class="dropdown-trigger">
                                    <button type="button" class="button is-small admin-row-menu-trigger" data-row-menu-trigger
                                            aria-haspopup="true" aria-expanded="false" aria-controls="@menuId"
                                            aria-label="More actions for @node.Title">
                                        <span class="icon"><i class="fas fa-ellipsis-v" aria-hidden="true"></i></span>
                                    </button>
                                </div>
                                <div class="dropdown-menu" id="@menuId" role="menu">
                                    <div class="dropdown-content">
                                        <a asp-controller="AdminContent" asp-action="Preview" asp-route-contentType="pages" asp-route-nodeId="@node.PageNodeId" class="dropdown-item" role="menuitem">
                                            <span class="icon"><i class="fas fa-eye" aria-hidden="true"></i></span>
                                            <span>Preview draft</span>
                                        </a>
                                        <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="pages" asp-route-id="@node.PageNodeId" class="dropdown-item" role="menuitem">
                                            <span class="icon"><i class="fas fa-cog" aria-hidden="true"></i></span>
                                            <span>Page settings</span>
                                        </a>
                                        <a asp-controller="AdminContent" asp-action="VersionHistory" asp-route-contentType="pages" asp-route-nodeId="@node.PageNodeId" class="dropdown-item" role="menuitem">
                                            <span class="icon"><i class="fas fa-history" aria-hidden="true"></i></span>
                                            <span>Version history</span>
                                        </a>
                                        <a asp-controller="AdminContent" asp-action="Create" asp-route-contentType="pages" asp-route-parentRoute="@node.Path" class="dropdown-item" role="menuitem">
                                            <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
                                            <span>Add child page</span>
                                        </a>
                                        <hr class="dropdown-divider" />
                                        @if (node.IsPublished && node.HasPendingChanges)
                                        {
                                            <form asp-controller="AdminContent" asp-action="Unpublish" asp-route-contentType="pages" asp-route-nodeId="@node.PageNodeId" method="post">
                                                <button type="submit" class="dropdown-item" role="menuitem">
                                                    <span class="icon"><i class="fas fa-eye-slash" aria-hidden="true"></i></span>
                                                    <span>Unpublish</span>
                                                </button>
                                            </form>
                                        }
                                        <button type="button" class="dropdown-item is-danger" role="menuitem"
                                                data-delete-trigger
                                                data-delete-name="@node.Title"
                                                data-delete-descendants="@node.DescendantCount"
                                                data-delete-descendant-label="child page"
                                                data-delete-url="@Url.Action("Delete", "AdminContent", new { contentType = "pages", id = node.PageNodeId })">
                                            <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                            <span>Delete</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </td>
            </tr>

            if (node.Children.Any())
            {
                await RenderTreeNodes(node.Children, depth + 1);
            }
        }
    }
}
