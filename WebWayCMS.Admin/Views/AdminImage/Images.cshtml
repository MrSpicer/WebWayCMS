@using WebWayCMS.Models.Image

@model ImageIndexViewModel

@{
    ViewData["Title"] = "Images";
    var newUrl = Url.Action("Create", "AdminContent", new { contentType = "images" })!;
}

<partial name="_AdminPageHeader" model='new AdminPageHeaderModel("Images") { NewUrl = newUrl, NewLabel = "New Image" }' />

<div class="container is-fluid admin-page-body">

        @if (!Model.Images.Any())
        {
            <partial name="_EmptyState" model='new EmptyStateModel("fa-image", "No images yet") { Subtitle = "Upload images to use across your site.", CreateUrl = newUrl, CreateLabel = "New Image" }' />
        }
        else
        {
            <div class="table-container admin-list-container">
                <table class="table is-fullwidth is-hoverable admin-list-table">
                    <caption class="is-sr-only">List of images</caption>
                    <thead>
                        <tr>
                            <th scope="col"><span class="is-sr-only">Preview</span></th>
                            <th scope="col">Title</th>
                            <th scope="col" class="is-hidden-mobile">Slug</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="is-hidden-mobile">Modified</th>
                            <th scope="col" class="admin-actions-col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cb in Model.Images)
                        {
                            <tr>
                                <td><img src="@WebWayCMS.Media.MediaUrl.For(cb.BlobHash)" alt="@cb.AltText" style="max-height:40px" /></td>
                                <td class="admin-list-main">
                                    <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="images" asp-route-id="@cb.NodeId" class="admin-list-title">@cb.Title</a>
                                </td>
                                <td class="is-hidden-mobile">@cb.Slug</td>
                                <td><partial name="_StatusBadge" model="(cb.IsPublished, false)" /></td>
                                <td class="is-hidden-mobile">@cb.ModificationDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div class="admin-row-actions">
                                        <partial name="_RowPublishToggle" model='new RowPublishToggleModel("images", cb.NodeId, cb.IsPublished)' />
                                        <a asp-controller="AdminContent" asp-action="Edit" asp-route-contentType="images" asp-route-id="@cb.NodeId" class="button is-small">
                                            <span class="icon"><i class="fas fa-pencil-alt" aria-hidden="true"></i></span>
                                            <span>Edit</span>
                                        </a>
                                        @{
                                            var rowMenu = new RowMenuModel("images", cb.NodeId.ToString(), cb.Title)
                                            {
                                                ItemsAfter = @<a href="@WebWayCMS.Media.MediaUrl.For(cb.BlobHash)" target="_blank" rel="noopener" class="dropdown-item" role="menuitem">
                                                    <span class="icon"><i class="fas fa-external-link-alt" aria-hidden="true"></i></span>
                                                    <span>Open image</span>
                                                </a>,
                                            };
                                        }
                                        <partial name="_RowMenu" model="rowMenu" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</div>
