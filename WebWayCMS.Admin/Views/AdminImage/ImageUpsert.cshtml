@model WebWayCMS.Models.Image.ImageUpsertViewModel

@{
    var isEdit = Model?.NodeId != null && Model.NodeId != Guid.Empty;
    ViewData["Title"] = isEdit ? "Edit Image" : "New Image";
    var header = new AdminPageHeaderModel((string)ViewData["Title"]!)
    {
        Fluid = false,
        NodeId = Model?.NodeId,
        Crumbs = [new AdminCrumb("Images", Url.Action("Index", "AdminContent", new { contentType = "images" })!)],
    };
    var form = new UpsertFormModel("images", Model!)
    {
        NodeId = Model?.NodeId,
        IsPublished = Model?.IsPublished == true,
    };
}

<partial name="_AdminPageHeader" model="header" />

<div class="container admin-page-body">
    <partial name="_UpsertForm" model="form" />
</div>
