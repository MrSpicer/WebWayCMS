@using WebWayCMS.Data.Models
@using WebWayCMS.Models.Shared

@model VersionHistoryViewModel

@{
    ViewData["Title"] = "Version History — " + Model.ItemTitle;
}

<div class="admin-page-header">
    <div class="container">
        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a href="@Model.BackUrl">Back to listing</a></li>
                <li class="is-active"><a aria-current="page">Version History: @Model.ItemTitle</a></li>
            </ul>
        </nav>
        <div class="admin-page-title-row">
            <div>
                <h1 class="title is-4">Version History</h1>
                <p class="subtitle is-6 has-text-grey">@Model.ItemTitle</p>
            </div>
        </div>
    </div>
</div>

<section class="section">
<div class="container is-fluid">

        <div class="table-container">
            <table class="table is-fullwidth is-striped">
                <caption class="is-sr-only">Version history for @Model.ItemTitle</caption>
                <thead>
                    <tr>
                        <th scope="col">Version</th>
                        <th scope="col">Title</th>
                        <th scope="col">State</th>
                        <th scope="col">Author</th>
                        <th scope="col">Change Note</th>
                        <th scope="col">Modified</th>
                        <th scope="col">Created</th>
                        <th scope="col"><span class="is-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Versions)
                    {
                        <tr>
                            <td><span class="tag is-light">v@(v.Version)</span></td>
                            <td>@v.Title</td>
                            <td>
                                @if (v.State == ContentVersionState.Published)
                                {
                                    <span class="tag is-success">Published</span>
                                }
                                else if (v.State == ContentVersionState.Draft)
                                {
                                    <span class="tag is-warning">Draft</span>
                                }
                                else if (v.State == ContentVersionState.Archived)
                                {
                                    <span class="tag is-dark">Archived</span>
                                }
                                else
                                {
                                    <span class="tag is-light">@v.State</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(v.AuthorName))
                                {
                                    @v.AuthorName
                                }
                                else if (v.CreatedBy.HasValue)
                                {
                                    <span class="has-text-grey-light">@v.CreatedBy</span>
                                }
                                else
                                {
                                    <span class="has-text-grey-light is-italic">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(v.ChangeNote))
                                {
                                    @v.ChangeNote
                                }
                                else
                                {
                                    <span class="has-text-grey-light is-italic">—</span>
                                }
                            </td>
                            <td>@v.ModificationDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@v.CreationDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <div class="buttons are-small">
                                    @if (Model.ParentKey != null)
                                    {
                                        <a asp-controller="AdminContent"
                                           asp-action="ChildVersionRestoreEdit"
                                           asp-route-contentType="@Model.ContentType"
                                           asp-route-parentKey="@Model.ParentKey"
                                           asp-route-childType="@Model.ChildType"
                                           asp-route-nodeId="@Model.NodeId"
                                           asp-route-id="@v.Id"
                                           class="button is-small">Restore</a>
                                        @if (!v.IsLatest)
                                        {
                                            <button type="button" class="button is-small is-danger is-light"
                                                    data-delete-trigger
                                                    data-delete-name="v@(v.Version) of @Model.ItemTitle"
                                                    data-delete-url="@Url.Action("ChildVersionDelete", "AdminContent", new { contentType = Model.ContentType, parentKey = Model.ParentKey, childType = Model.ChildType, nodeId = Model.NodeId, id = v.Id })">
                                                <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                                <span>Delete</span>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        @if (!v.IsLatest)
                                        {
                                            <form asp-controller="AdminContent"
                                                  asp-action="RestoreVersion"
                                                  asp-route-contentType="@Model.ContentType"
                                                  asp-route-nodeId="@Model.NodeId"
                                                  asp-route-id="@v.Id"
                                                  method="post" class="is-inline-block">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="button is-small">Restore</button>
                                            </form>
                                        }
                                        @if (!v.IsLatest)
                                        {
                                            <button type="button" class="button is-small is-danger is-light"
                                                    data-delete-trigger
                                                    data-delete-name="v@(v.Version) of @Model.ItemTitle"
                                                    data-delete-url="@Url.Action("VersionDelete", "AdminContent", new { contentType = Model.ContentType, nodeId = Model.NodeId, id = v.Id })">
                                                <span class="icon"><i class="fas fa-trash" aria-hidden="true"></i></span>
                                                <span>Delete</span>
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
</div>
</section>
