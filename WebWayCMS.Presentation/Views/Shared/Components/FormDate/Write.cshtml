@model WebWayCMS.Forms.FormFieldContext
@{
    var strValue = WebWayCMS.Forms.FormValueFormatter.FormatDateValue(Model.Value);
    var attrs = WebWayCMS.Forms.FormAttributeBuilder.For(Model)
        .Type("date").Css("input")
        .Naming().Value(strValue).Required().DescribedBy()
        .Build();
}
<form-field field="@Model">
    <input @Html.Raw(attrs) />
</form-field>
