@using WebWayCMS.Models.CMSRoute
@model RouteNavigationViewModel

@if (Model.Items.Any())
{
    @foreach (var item in Model.Items)
    {
        await RenderNavItem(item);
    }
}

@functions {
    async Task RenderNavItem(RouteNavigationItem item)
    {
        <a class="navbar-item" href="@item.Path">@item.Title</a>
        @if (item.Children.Any())
        {
            <ul>
                @foreach (var child in item.Children)
                {
                    <li>
                        @{ await RenderNavItem(child); }
                    </li>
                }
            </ul>
        }
    }
}
