<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- The GitHub token is supplied via the %GITHUB_TOKEN% environment variable, not stored here.
       NuGet only exposes the deprecated "ClearTextPassword" field for env-var expansion; the secret
       itself never lives in source. Keep GITHUB_TOKEN a fine-grained, read:packages-only PAT. -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="MrSpicer" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
