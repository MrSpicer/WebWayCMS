@{
    var path = ViewData["ParamValue"] as string;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="alert alert-danger border-danger border-2 text-center p-5">
            <h1 class="display-4 mb-3">Documentation Path</h1>
            <p class="lead">Catch-all parameter captured: <strong class="text-decoration-underline">@path</strong></p>
            <code class="fs-5">@ViewData["Pattern"]</code>
        </div>

        <div class="card mt-4">
            <div class="card-header">Captured Values</div>
            <div class="card-body">
                <table class="table">
                    <tr><th>Parameter</th><th>Value</th></tr>
                    <tr><td><code>path</code></td><td class="fw-bold text-danger font-monospace">@path</td></tr>
                </table>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">What This Tests</div>
            <div class="card-body">
                <p>The <code>{**param}</code> catch-all syntax captures everything after the literal prefix, including slashes. This is useful for hierarchical URL structures like documentation paths, file browsers, or nested resource paths.</p>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/code-test/docs/api/v2/users" class="btn btn-outline-danger me-2">Try /api/v2/users</a>
            <a href="/code-test/docs/guides/nested/deep" class="btn btn-outline-danger me-2">Try Deep Path</a>
            <a href="/code-test" class="btn btn-secondary">Back to Index</a>
        </div>
    </div>
</div>
