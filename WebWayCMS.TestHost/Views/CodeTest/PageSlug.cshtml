@{
    var slug = ViewData["ParamValue"] as string;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="alert alert-dark border-dark border-2 text-center p-5">
            <h1 class="display-4 mb-3">Page: <strong class="text-decoration-underline">@slug</strong></h1>
            <p class="lead">The slug was extracted from a <strong>mixed literal + parameter segment</strong>.</p>
            <code class="fs-5">@ViewData["Pattern"]</code>
        </div>

        <div class="card mt-4">
            <div class="card-header">How It Works</div>
            <div class="card-body">
                <p>The URL segment <code>page-my-article</code> matches the pattern <code>page-{slug}</code>:</p>
                <ul>
                    <li>The literal prefix <code>page-</code> is matched first</li>
                    <li>The remainder <code>my-article</code> is captured as the <code>slug</code> parameter</li>
                </ul>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">Captured Values</div>
            <div class="card-body">
                <table class="table">
                    <tr><th>Parameter</th><th>Value</th></tr>
                    <tr><td><code>slug</code></td><td class="fw-bold text-dark">@slug</td></tr>
                </table>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/code-test/page-awesome-post" class="btn btn-outline-dark me-2">Try /page-awesome-post</a>
            <a href="/code-test" class="btn btn-secondary">Back to Index</a>
        </div>
    </div>
</div>
