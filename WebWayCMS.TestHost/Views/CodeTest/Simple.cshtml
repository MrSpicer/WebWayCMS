@{
    ViewData["Title"] = "Simple Route";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="alert alert-success border-success border-2 text-center p-5">
            <h1 class="display-4 mb-3">Simple Route &mdash; Loaded!</h1>
            <p class="lead">This page was served from a <strong>static literal pattern</strong> with no route parameters.</p>
            <code class="fs-5">[CmsRoute("/code-test/simple")]</code>
        </div>

        <div class="card mt-4">
            <div class="card-header">What This Tests</div>
            <div class="card-body">
                <p>The <code>[CmsRoute]</code> attribute can register a simple static URL pattern. The CMS route transformer matches the incoming request against the DB-stored route and dispatches directly to the controller action &mdash; no admin UI, no page type, no configuration needed.</p>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/code-test" class="btn btn-secondary">Back to Index</a>
        </div>
    </div>
</div>
