@{
    ViewData["Title"] = "Multi Route B";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="alert alert-success border-success border-2 text-center p-5">
            <h1 class="display-4 mb-3">Multi Route <span class="badge bg-success">B</span></h1>
            <p class="lead">This is route <strong>/multi/b</strong> &mdash; a <em>different</em> route on the <em>same</em> controller class.</p>
            <code class="fs-5">@ViewData["Pattern"]</code>
        </div>

        <div class="card mt-4">
            <div class="card-header">What This Tests</div>
            <div class="card-body">
                <p>Two separate <code>[CmsRoute]</code> attributes on one controller each create their own route records. The CMS dispatches to the correct action method based on which pattern matched.</p>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/code-test/multi/a" class="btn btn-outline-success me-2">Go to Route A</a>
            <a href="/code-test" class="btn btn-secondary">Back to Index</a>
        </div>
    </div>
</div>
