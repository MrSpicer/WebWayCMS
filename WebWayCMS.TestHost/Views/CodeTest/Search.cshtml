@{
    var query = ViewData["ParamValue"] as string;
    var hasQuery = !string.IsNullOrEmpty(query);
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="alert @(hasQuery ? "alert-warning" : "alert-secondary") border-2 text-center p-5">
            <h1 class="display-4 mb-3">Search Results</h1>
            @if (hasQuery)
            {
                <p class="lead">Searching for: <strong class="text-decoration-underline">@query</strong></p>
            }
            else
            {
                <p class="lead text-muted fst-italic">No query provided &mdash; optional parameter was omitted.</p>
            }
            <code class="fs-5">@ViewData["Pattern"]</code>
        </div>

        <div class="card mt-4">
            <div class="card-header">Captured Values</div>
            <div class="card-body">
                <table class="table">
                    <tr><th>Parameter</th><th>Value</th><th>Status</th></tr>
                    <tr>
                        <td><code>query</code></td>
                        <td class="fw-bold">@(hasQuery ? query : "(null)")</td>
                        <td>@(hasQuery ? Html.Raw("<span class='badge bg-success'>Provided</span>") : Html.Raw("<span class='badge bg-secondary'>Omitted</span>"))</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">What This Tests</div>
            <div class="card-body">
                <p>The <code>{param?}</code> syntax makes a route parameter optional. The route matches both <code>/search/hello</code> and <code>/search</code>. The controller receives <code>null</code> when the parameter is omitted.</p>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/code-test/search/test" class="btn btn-outline-warning me-2">Try with query</a>
            <a href="/code-test/search" class="btn btn-outline-secondary me-2">Try without query</a>
            <a href="/code-test" class="btn btn-secondary">Back to Index</a>
        </div>
    </div>
</div>
