@{
    var id = ViewData["ParamValue"] as Guid?;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="alert alert-secondary border-secondary border-2 text-center p-5">
            <h1 class="display-4 mb-3">Item ID</h1>
            <p class="lead">GUID captured from route: <strong class="text-monospace">@id</strong></p>
            <code class="fs-5">@ViewData["Pattern"]</code>
        </div>

        <div class="card mt-4">
            <div class="card-header">Captured Values</div>
            <div class="card-body">
                <table class="table">
                    <tr><th>Parameter</th><th>Value</th></tr>
                    <tr><td><code>id</code></td><td class="fw-bold font-monospace text-secondary">@id</td></tr>
                </table>
            </div>
        </div>

        <div class="card mt-3 border-warning">
            <div class="card-header bg-warning text-dark">Constraint Verification</div>
            <div class="card-body">
                <p>The <code>:guid</code> constraint ensures only valid GUID format values match. Try <code>/code-test/item/not-a-guid</code> &mdash; it will <strong>404</strong>.</p>
                <a href="/code-test/item/not-a-guid" class="btn btn-outline-danger btn-sm">Test invalid GUID</a>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/code-test" class="btn btn-secondary">Back to Index</a>
        </div>
    </div>
</div>
