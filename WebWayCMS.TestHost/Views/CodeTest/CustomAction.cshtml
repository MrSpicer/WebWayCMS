@{
    ViewData["Title"] = "Custom Action";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="alert alert-success border-success border-2 text-center p-5">
            <h1 class="display-4 mb-3">Custom Action &mdash; Loaded!</h1>
            <p class="lead">This page was served from a controller method named <code>CustomAction()</code> but routed via <code>Action = "Custom"</code>.</p>
            <code class="fs-5">@ViewData["Pattern"]</code>
        </div>

        <div class="card mt-4">
            <div class="card-header">How It Works</div>
            <div class="card-body">
                <p>The <code>[CmsRoute]</code> attribute's <code>Action</code> property lets you specify which action method to invoke. The C# method name doesn't need to match the route's implied action name.</p>
                <pre class="bg-light p-3 rounded"><code>[CmsRoute("/code-test/custom-action", Action = "Custom")]
public class CodeTestController : Controller
{
    [ActionName("Custom")]
    public IActionResult CustomAction() { ... }
}</code></pre>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/code-test" class="btn btn-secondary">Back to Index</a>
        </div>
    </div>
</div>
